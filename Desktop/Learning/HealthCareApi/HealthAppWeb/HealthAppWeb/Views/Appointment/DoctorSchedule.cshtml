@model IEnumerable<HospitalManagement.ViewModels.DoctorScheduleItemViewModel>

@{
    ViewBag.Title = "Doctor Schedule";
    var selectedDate = Request.QueryString["date"];
}

<div class="page-card">
    <div class="page-header">
        <div>
            <h2 class="page-title">Doctor Schedule</h2>
            <div class="page-subtitle">View today's or weekly appointments.</div>
        </div>
    </div>

    @using (Html.BeginForm("DoctorSchedule", "Appointments", FormMethod.Get))
    {
        <div class="row" style="margin-bottom:18px;">
            <div class="col-md-4">
                <input type="date"
                       name="date"
                       value="@selectedDate"
                       class="form-control" />
            </div>

            <div class="col-md-2">
                <button type="submit" class="btn btn-default btn-block">View Date</button>
            </div>

            <div class="col-md-2">
                @Url.Action("
                   class="btn btn-info btn-block">
                    Weekly
                </a>
            </div>
        </div>
            }

    <table class="table table-hover">
        <thead>
            <tr>
                <th>Date</th>
                <th>Time Slot</th>
                <th>Patient</th>
                <th>Status</th>
                <th style="width:260px;">Actions</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var item in Model)
                        {
            <tr>
                <td>@item.ScheduledDate.ToString("dd-MMM-yyyy")</td>
                <td>@item.TimeSlot</td>
                <td>
                    @Url.Action(">
                        @item.PatientName
                    </a>
                </td>
                <td>
                    @Html.Partial("_StatusBadge", item.Status)
                </td>
                <td>
                    @Url.Action("
                       class="btn btn-xs btn-primary">
                        Update Status
                    </a>

                    @if (item.Status == "Completed")
                                            {
                    @Url.Action("
                       class="btn btn-xs btn-success">
                        Add Record
                    </a>
}
                </td>
            </tr>
                        }
        </tbody>
    </table>
</div>