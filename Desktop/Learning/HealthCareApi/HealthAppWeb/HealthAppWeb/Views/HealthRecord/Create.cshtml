@model HospitalManagement.ViewModels.HealthRecordCreateViewModel

@{
    ViewBag.Title = "Add Health Record";
}

<div class="page-card">
    <div class="page-header">
        <div>
            <h2 class="page-title">Add Health Record</h2>
            <div class="page-subtitle">Enter diagnosis, prescription and notes for completed appointment.</div>
        </div>
    </div>

    <div class="profile-grid" style="margin-bottom:20px;">
        <div class="profile-item">
            <div class="profile-label">Patient</div>
            <div class="profile-value">@Model.PatientName</div>
        </div>

        <div class="profile-item">
            <div class="profile-label">Doctor</div>
            <div class="profile-value">@Model.DoctorName</div>
        </div>

        <div class="profile-item">
            <div class="profile-label">Visit Date</div>
            <div class="profile-value">@Model.VisitDate.ToString("dd-MMM-yyyy hh:mm tt")</div>
        </div>
    </div>

    @using (Html.BeginForm("Create", "HealthRecords", FormMethod.Post))
    {
        @Html.AntiForgeryToken()

        @Html.HiddenFor(m => m.AppointmentId)
        @Html.HiddenFor(m => m.PatientId)
        @Html.HiddenFor(m => m.DoctorId)

        @Html.ValidationSummary(true, "", new { @class = "text-danger" })

        <div class="form-group">
            @Html.LabelFor(m => m.Diagnosis)
            @Html.TextAreaFor(m => m.Diagnosis, new { @class = "form-control", rows = "4", placeholder = "Enter diagnosis" })
            @Html.ValidationMessageFor(m => m.Diagnosis, "", new { @class = "text-danger" })
        </div>

        <div class="form-group">
            @Html.LabelFor(m => m.Prescription)
            @Html.TextAreaFor(m => m.Prescription, new { @class = "form-control", rows = "4", placeholder = "Enter prescription" })
            @Html.ValidationMessageFor(m => m.Prescription, "", new { @class = "text-danger" })
        </div>

        <div class="form-group">
            @Html.LabelFor(m => m.Notes)
            @Html.TextAreaFor(m => m.Notes, new { @class = "form-control", rows = "4", placeholder = "Optional notes" })
            @Html.ValidationMessageFor(m => m.Notes, "", new { @class = "text-danger" })
        </div>

        <button type="submit" class="btn btn-success">Save Health Record</button>
        @Url.Action(" class="btn btn - default">Cancel</a>
    }
    </div>

    @section scripts {
        @Scripts.Render("~/bundles/jqueryval")
    }