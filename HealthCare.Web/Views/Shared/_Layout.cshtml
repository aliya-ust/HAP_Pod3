<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>@ViewBag.Title - HealthCare System</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />

    <style>
        body {
            margin: 0;
            background: #f5f7fb;
        }

        /* MAIN CONTENT AREA */
        .main-content {
            margin-left: 300px; /* same as sidebar width */
        }

        /* TOP BAR */
        .topbar {
            height: 60px;
            background: white;
            border-bottom: 1px solid #e5e7eb;
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 0 20px;
            position: sticky;
            top: 0;
            z-index: 10;
        }

        /* PAGE CONTENT */
        .content-area {
            padding: 20px;
        }
    </style>
</head>

<body>

    <!-- SIDEBAR (YOUR SEPARATE FILE) -->
    @Html.Partial("_Sidebar")

    <!-- MAIN AREA -->
    <div class="main-content">

        <!-- TOPBAR -->
        <div class="topbar">
            <div class="fw-bold">
                @ViewBag.Title
            </div>

            <div>
                <span class="text-muted">HealthCare Management System</span>
            </div>
        </div>

        <!-- PAGE CONTENT -->
        <div class="content-area">
            @RenderBody()
        </div>

    </div>

    @RenderSection("Scripts", required: false)

</body>
</html>