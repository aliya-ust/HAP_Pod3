@model HealthCare.Shared.DTOs.HealthRecord.HealthRecordDto

@{
    ViewBag.Title = "Add Health Record";
}

<div class="container mt-4">

    <h2>Add Health Record</h2>

    @using (Html.BeginForm())
    {
        @Html.AntiForgeryToken()

        <div class="card p-4">

            <div class="mb-3">
                <label>Appointment Id</label>
                @Html.TextBoxFor(m => m.AppointmentId, new { @class = "form-control", required = "required" })
            </div>

            <div class="mb-3">
                <label>Diagnosis</label>
                @Html.TextAreaFor(m => m.Diagnosis, new { @class = "form-control", required = "required" })
            </div>

            <div class="mb-3">
                <label>Prescription</label>
                @Html.TextAreaFor(m => m.Prescription, new { @class = "form-control", required = "required" })
            </div>

            <div class="mb-3">
                <label>Notes</label>
                @Html.TextAreaFor(m => m.Notes, new { @class = "form-control" })
            </div>

            <button class="btn btn-success">Save</button>
            <a href="@Url.Action("Index")" class="btn btn-secondary">Back</a>

        </div>
    }

</div>