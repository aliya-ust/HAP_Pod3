@model HealthCare.Shared.DTOs.HealthRecord.HealthRecordDto

@{
    ViewBag.Title = "Add Health Record";
}

<div class="container mt-4">

    <!-- HEADER -->
    <div class="mb-4">
        <h2 class="fw-bold">Add Health Record</h2>
        <p class="text-muted">
            Enter diagnosis, prescription and notes for confirmed appointment.
        </p>
    </div>

    <!-- SHOW SUCCESS MESSAGE -->
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">
            @TempData["Success"]
        </div>
    }

    <!-- SHOW ERROR -->
    @Html.ValidationSummary(true, "", new { @class = "alert alert-danger" })

    <!-- FORM -->
    @using (Html.BeginForm("Create", "HealthRecord", FormMethod.Post))
    {
        @Html.AntiForgeryToken()

        <!-- HIDDEN APPOINTMENT ID -->
        @Html.HiddenFor(m => m.AppointmentId)

        <!-- SHOW APPOINTMENT ID -->
        <div class="mb-3">
            <label class="form-label fw-bold">Appointment ID</label>
            <input type="text"
                   class="form-control"
                   value="@Model.AppointmentId"
                   readonly />
        </div>

        <!-- DIAGNOSIS -->
        <div class="mb-3">
            @Html.LabelFor(m => m.Diagnosis, new { @class = "form-label fw-bold" })
            @Html.TextAreaFor(m => m.Diagnosis, new
            {
                @class = "form-control",
                rows = 4,
                placeholder = "Enter diagnosis"
            })
            @Html.ValidationMessageFor(m => m.Diagnosis, "", new { @class = "text-danger" })
        </div>

        <!-- PRESCRIPTION -->
        <div class="mb-3">
            @Html.LabelFor(m => m.Prescription, new { @class = "form-label fw-bold" })
            @Html.TextAreaFor(m => m.Prescription, new
            {
                @class = "form-control",
                rows = 4,
                placeholder = "Enter prescription"
            })
            @Html.ValidationMessageFor(m => m.Prescription, "", new { @class = "text-danger" })
        </div>

        <!-- NOTES -->
        <div class="mb-3">
            @Html.LabelFor(m => m.Notes, new { @class = "form-label fw-bold" })
            @Html.TextAreaFor(m => m.Notes, new
            {
                @class = "form-control",
                rows = 4,
                placeholder = "Optional notes"
            })
            @Html.ValidationMessageFor(m => m.Notes, "", new { @class = "text-danger" })
        </div>

        <!-- BUTTONS -->
        <div class="mt-3">
            <button type="submit" class="btn btn-success">
                Save Health Record
            </button>

            <a href="@Url.Action("List", "HealthRecord")"
               class="btn btn-secondary">
                Cancel
            </a>
        </div>
    }

</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}