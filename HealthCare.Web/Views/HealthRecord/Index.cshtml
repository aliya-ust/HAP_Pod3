@model HealthCare.Shared.PagedResult<HealthCare.Shared.DTOs.HealthRecord.HealthRecordDto>

@{
    ViewBag.Title = "Health Records";
}

<div class="container mt-4">

    <h2>Health Record Management</h2>

    <!-- SEARCH -->
    <div class="card p-3 mb-3">

        <form method="get" id="searchForm">

            <div class="row">

                <div class="col-md-5">
                    <label>Patient Id</label>
                    <input type="number" name="patientId" id="patientId" class="form-control" />
                </div>

                <div class="col-md-2 text-center mt-4 fw-bold">
                    OR
                </div>

                <div class="col-md-5">
                    <label>Doctor Id</label>
                    <input type="number" name="doctorId" id="doctorId" class="form-control" />
                </div>

            </div>

            <div class="mt-3">
                <button class="btn btn-primary">Search</button>

                <a href="@Url.Action("Add")" class="btn btn-success">
                    Add Health Record
                </a>
            </div>

            <small id="err" class="text-danger"></small>

        </form>

    </div>

    <!-- TABLE -->
    <div class="card p-3">

        <table class="table table-bordered">

            <thead>
                <tr>
                    <th>Record Id</th>
                    <th>Appointment Id</th>
                    <th>Visit Date</th>
                    <th>Diagnosis</th>
                    <th>Prescription</th>
                    <th>Notes</th>
                    <th>Actions</th>
                </tr>
            </thead>

            <tbody>
                @if (Model?.Items != null && Model.Items.Any())
                {
                    foreach (var item in Model.Items)
                    {
                        <tr>
                            <td>@item.RecordId</td>
                            <td>@item.AppointmentId</td>
                            <td>@item.VisitDate.ToString("yyyy-MM-dd")</td>
                            <td>@item.Diagnosis</td>
                            <td>@item.Prescription</td>
                            <td>@item.Notes</td>

                            <td>

                                <button class="btn btn-sm btn-danger"
                                        onclick="deleteRecord(@item.RecordId)">
                                    Delete
                                </button>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="7" class="text-center">No records found</td>
                    </tr>
                }
            </tbody>

        </table>

    </div>

</div>

<script>
    document.getElementById("searchForm").addEventListener("submit", function (e) {

        var p = document.getElementById("patientId").value;
        var d = document.getElementById("doctorId").value;

        if (p && d) {
            e.preventDefault();
            document.getElementById("err").innerText =
                "Search by only Patient OR Doctor, not both.";
        }
    });

    function deleteRecord(id) {
        if (confirm("Are you sure you want to delete this record?")) {
            window.location.href = "/HealthRecord/Delete?id=" + id;
        }
    }
</script>