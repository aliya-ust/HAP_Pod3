@model HealthCare.Shared.DTOs.Patient.PatientDto

@{
    var maxDateOfBirth = DateTime.Today.AddDays(-1).ToString("yyyy-MM-dd");
}

<div id="formContainer">
    @using (Html.BeginForm("Register", "Patient", FormMethod.Post, new { id = "registerForm" }))
    {
        @Html.AntiForgeryToken()


        <div class="row g-3">

            <!-- ✅ Full Name -->
            <div class="col-md-6">
                @Html.LabelFor(m => m.FullName, new { @class = "form-label fw-semibold" })

                @Html.TextBoxFor(m => m.FullName, new
                {
                    @class = "form-control",
                    required = "required",
                    minlength = "3",
                    maxlength = "100"
                })

                @Html.ValidationMessageFor(m => m.FullName, "", new { @class = "text-danger" })
            </div>

            <!-- ✅ Date of Birth -->
            <div class="col-md-6">
                @Html.LabelFor(m => m.DateOfBirth, new { @class = "form-label fw-semibold" })

                @Html.TextBoxFor(m => m.DateOfBirth, "{0:yyyy-MM-dd}", new
                {
                    @class = "form-control",
                    type = "date",
                    max = maxDateOfBirth,
                    required = "required"
                })

                @Html.ValidationMessageFor(m => m.DateOfBirth, "", new { @class = "text-danger" })
            </div>

            <!-- ✅ Gender -->
            <div class="col-md-6">
                @Html.LabelFor(m => m.Gender, new { @class = "form-label fw-semibold d-block" })

                <div class="d-flex gap-3">
                    @foreach (var g in new[] { "Male", "Female", "Other" })
                    {
                        <div class="form-check">
                            @Html.RadioButtonFor(m => m.Gender, g, new { @class = "form-check-input", required = "required" })
                            <label class="form-check-label">@g</label>
                        </div>
                    }
                </div>

                @Html.ValidationMessageFor(m => m.Gender, "", new { @class = "text-danger" })
            </div>

            <!-- ✅ Phone -->
            <div class="col-md-6">
                @Html.LabelFor(m => m.PhoneNumber, new { @class = "form-label fw-semibold" })

                @Html.TextBoxFor(m => m.PhoneNumber, new
                {
                    @class = "form-control",
                    pattern = "[0-9]{10}",
                    maxlength = "10",
                    required = "required"
                })

                @Html.ValidationMessageFor(m => m.PhoneNumber, "", new { @class = "text-danger" })
            </div>

            <!-- ✅ Email -->
            <div class="col-md-6">
                @Html.LabelFor(m => m.Email, new { @class = "form-label fw-semibold" })

                @Html.TextBoxFor(m => m.Email, new
                {
                    @class = "form-control",
                    type = "email",
                    required = "required"
                })

                @Html.ValidationMessageFor(m => m.Email, "", new { @class = "text-danger" })
            </div>

            <!-- ✅ Insurance -->
            <div class="col-md-6">
                @Html.LabelFor(m => m.InsuranceId, new { @class = "form-label fw-semibold" })

                @Html.TextBoxFor(m => m.InsuranceId, new
                {
                    @class = "form-control",
                    maxlength = "50"
                })

                @Html.ValidationMessageFor(m => m.InsuranceId, "", new { @class = "text-danger" })
            </div>

        </div>

        <!-- ✅ Actions -->
        <div class="mt-4 text-end">
            <button type="reset" class="btn btn-outline-danger me-2">
                Clear
            </button>

            <button type="submit" class="btn btn-primary">
                Register
            </button>
        </div>
    }
</div>

<!-- ✅ AJAX SCRIPT -->
<script>
    $(document).ready(function () {

        $("#registerForm").submit(function (e) {
            e.preventDefault();

            var form = $(this);

            $.ajax({
                url: form.attr("action"),
                type: "POST",
                data: form.serialize(),
                success: function (response) {

                    // ✅ SUCCESS
                    if (response && response.success) {
                        alert("Patient created successfully");
                        location.reload();
                        return;
                    }

                    // ✅ VALIDATION ERROR (re-render partial)
                    $("#formContainer").html(response);

                    // 🔥 IMPORTANT: Re-enable validation
                    $.validator.unobtrusive.parse("#formContainer");
                },
                error: function () {
                    alert("Something went wrong");
                }
            });
        });

    });
</script>