@model HealthCare.Shared.PagedResult<HealthCare.Shared.DTOs.Patient.PatientDto>

@{
    ViewBag.Title = "Patients";
}


<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">


<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

<!-- PROFILE MODAL -->
<div class="modal fade" id="profileModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content p-3">

            <div class="d-flex justify-content-between">
                <h4>Patient Profile</h4>
                <button class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <hr />

            <div id="profileContent">

            </div>

            <div class="mt-3 text-end">
                <a id="editBtn" class="btn btn-warning">
                    <i class="fa fa-edit"></i> Edit
                </a>

                <button id="deleteBtn" class="btn btn-danger">
                    <i class="fa fa-trash"></i> Delete
                </button>
            </div>

        </div>
    </div>
</div>

<div class="container py-4">

    <!-- HEADER -->
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="fw-bold">Patient Management</h2>

        <a href="@Url.Action("Register", "Patient")" class="btn btn-primary">
            ➕ Register Patient
        </a>
    </div>

    <!-- SEARCH -->
    <form method="get" action="@Url.Action("Index", "Patient")" class="mb-3">
        <div class="input-group">
            <input type="text"
                   name="searchTerm"
                   value="@Request["searchTerm"]"
                   class="form-control"
                   placeholder="Search by ID or Name"
                   onfocus="showHint()" />

            <button class="btn btn-outline-primary">Search</button>
        </div>

        <small id="hint" class="text-muted d-none">
            🔎 You can search using Patient ID or Patient Name
        </small>
    </form>

    <!-- TABLE -->
    <div class="card shadow-sm">
        <div class="card-body p-0">

            <table class="table table-hover mb-0">
                <thead class="table-dark">
                    <tr>
                        <th>ID</th>
                        <th>Name</th>
                        <th>Email</th>
                        <th width="200">Actions</th>
                    </tr>
                </thead>

                <tbody>
                    @if (Model?.Items != null && Model.Items.Any())
                    {
                        foreach (var p in Model.Items)
                        {
                            <tr>
                                <td>@p.PatientId</td>
                                <td>@p.FullName</td>
                                <td>@p.Email</td>
                                <td>
                                    <!-- VIEW -->
                                    <button class="btn btn-sm btn-info" onclick="showProfile(@p.PatientId)">
                                        <i class="fa fa-eye"></i>
                                    </button>

                                    <!-- EDIT -->
                                    <a class="btn btn-sm btn-warning"
                                       href="@Url.Action("Edit", new { id = p.PatientId })">
                                        <i class="fa fa-edit"></i>
                                    </a>

                                    <!-- DELETE -->
                                    <button class="btn btn-sm btn-danger"
                                            onclick="confirmDelete(@p.PatientId)">
                                        <i class="fa fa-trash"></i>
                                    </button>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="4" class="text-center text-muted p-3">
                                No patients found
                            </td>
                        </tr>
                    }
                </tbody>
            </table>

        </div>
    </div>

    <nav class="mt-4">
        <ul class="pagination justify-content-center">

            <!-- Previous -->
            <li class="page-item @(Model.PageNumber == 1 ? "disabled" : "")">
                <a class="page-link"
                   href="@Url.Action("Index", new {
                   pageNumber = Model.PageNumber - 1,
                   searchTerm = Request["searchTerm"]
               })">
                    Previous
                </a>
            </li>

            <!-- Page Numbers -->
            @for (int i = 1; i <= (int)Math.Ceiling((double)Model.TotalCount / Model.PageSize); i++)
            {
                <li class="page-item @(i == Model.PageNumber ? "active" : "")">
                    <a class="page-link"
                       href="@Url.Action("Index", new {
                       pageNumber = i,
                       searchTerm = Request["searchTerm"]
                   })">
                        @i
                    </a>
                </li>
            }

            <!-- Next -->
            <li class="page-item @(Model.PageNumber * Model.PageSize >= Model.TotalCount ? "disabled" : "")">
                <a class="page-link"
                   href="@Url.Action("Index", new {
                   pageNumber = Model.PageNumber + 1,
                   searchTerm = Request["searchTerm"]
               })">
                    Next
                </a>
            </li>

        </ul>
    </nav>
</div>

<!-- JS -->
<script>
    function showHint() {
        document.getElementById("hint").classList.remove("d-none");
    }
</script>

<script>
    function showProfile(id) {

        fetch('/Patient/Profile/' + id)
            .then(res => {
                if (!res.ok) throw new Error("Failed to load profile");
                return res.text();
            })
            .then(html => {

                document.getElementById("profileContent").innerHTML = html;

                document.getElementById("editBtn").href = '/Patient/Edit/' + id;

                document.getElementById("deleteBtn").onclick = function () {
                    confirmDelete(id);
                };

                var modal = new bootstrap.Modal(document.getElementById('profileModal'));
                modal.show();
            })
            .catch(err => {
                console.error(err);
                alert("Error loading profile");
            });
    }
</script>

<script>
    function confirmDelete(id) {
        if (confirm("Are you sure you want to delete this patient?")) {

            var token = document.querySelector('input[name="__RequestVerificationToken"]').value;

            var form = document.createElement("form");
            form.method = "post";
            form.action = '/Patient/Delete';

            form.innerHTML =
                '<input type="hidden" name="id" value="' + id + '" />' +
                '<input type="hidden" name="__RequestVerificationToken" value="' + token + '" />';

            document.body.appendChild(form);
            form.submit();
        }
    }
</script>

@Html.AntiForgeryToken()