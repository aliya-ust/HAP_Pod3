@model HealthCare.Shared.DTOs.Patient.PatientDto

@{
    ViewBag.Title = "Register Patient";
}

<div class="container py-4">

    <h2>Register Patient</h2>

    @Html.ValidationSummary(true, "", new { @class = "text-danger" })

    @using (Html.BeginForm())
    {
        @Html.AntiForgeryToken()

        <div class="mb-2">
            @Html.TextBoxFor(m => m.FullName, new { @class = "form-control", placeholder = "Full Name" })
            @Html.ValidationMessageFor(m => m.FullName, "", new { @class = "text-danger" })
        </div>

        <div class="mb-2">
            @Html.TextBoxFor(m => m.DateOfBirth, new { @class = "form-control", type = "date" })
            @Html.ValidationMessageFor(m => m.DateOfBirth, "", new { @class = "text-danger" })
        </div>

        <div class="mb-2">
            @Html.TextBoxFor(m => m.Gender, new { @class = "form-control", placeholder = "Gender" })
            @Html.ValidationMessageFor(m => m.Gender, "", new { @class = "text-danger" })
        </div>

        <div class="mb-2">
            @Html.TextBoxFor(m => m.PhoneNumber, new { @class = "form-control", placeholder = "Phone" })
            @Html.ValidationMessageFor(m => m.PhoneNumber, "", new { @class = "text-danger" })
        </div>

        <div class="mb-2">
            @Html.TextBoxFor(m => m.Email, new { @class = "form-control", placeholder = "Email" })
            @Html.ValidationMessageFor(m => m.Email, "", new { @class = "text-danger" })
        </div>

        <div class="mb-2">
            @Html.TextBoxFor(m => m.InsuranceId, new { @class = "form-control", placeholder = "Insurance ID" })
            @Html.ValidationMessageFor(m => m.InsuranceId, "", new { @class = "text-danger" })
        </div>

        <button type="submit" class="btn btn-primary">Register</button>

        <a href="@Url.Action("Index", "Patient")" class="btn btn-secondary">
            Back
        </a>
    }
</div>