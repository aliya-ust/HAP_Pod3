@using HealthCare.Shared.DTOs.Patient
@model CreatePatientDto

@{
    ViewBag.Title = "Register Patient";
    var maxDateOfBirth = DateTime.Today.AddDays(-1).ToString("yyyy-MM-dd");
}

<div class="container-fluid">

    <h2 class="fw-bold mb-4">Register Patient</h2>

    @using (Html.BeginForm("Register", "Patient", FormMethod.Post))
    {
        <div class="row g-3">

            <div class="col-md-6">
                <label>Full Name</label>
                @Html.TextBoxFor(m => m.FullName, new { @class = "form-control" })
            </div>

            <div class="col-md-6">
                <label>Date of Birth</label>
                @Html.TextBoxFor(m => m.DateOfBirth, new { @type = "date", @class = "form-control", @max = maxDateOfBirth })
            </div>

            <div class="col-md-6">
                <label>Gender</label>
                @Html.DropDownListFor(m => m.Gender,
                    new SelectList(new[] { "Male", "Female", "Other" }),
                    "Select Gender",
                    new { @class = "form-control" })
            </div>

            <div class="col-md-6">
                <label>Phone</label>
                @Html.TextBoxFor(m => m.PhoneNumber, new { @class = "form-control" })
            </div>

            <div class="col-md-6">
                <label>Email</label>
                @Html.TextBoxFor(m => m.Email, new { @class = "form-control", type = "email" })
            </div>

            <div class="col-md-6">
                <label>Insurance ID</label>
                @Html.TextBoxFor(m => m.InsuranceId, new { @class = "form-control" })
            </div>

        </div>

        <div class="mt-4 text-end">
            <a href="@Url.Action("List","Patient")" class="btn btn-secondary">Cancel</a>
            <button type="submit" class="btn btn-success">Register</button>
        </div>
    }

</div>