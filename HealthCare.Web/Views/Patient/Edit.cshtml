@model HealthCare.Shared.DTOs.Patient.PatientDto

@{
    ViewBag.Title = "Edit Patient";
}

<div class="container py-4">

    <h2>Edit Patient</h2>

    @Html.ValidationSummary(true, "", new { @class = "tex-danger" })

    @using (Html.BeginForm())
    {
        @Html.AntiForgeryToken()

        @Html.HiddenFor(m => m.PatientId)

<div class="mb-2">
    @Html.LabelFor(m => m.FullName)
    @Html.TextBoxFor(m => m.FullName, new { @class = "form-control" })
    @Html.ValidationMessageFor(m => m.FullName, "", new { @class = "text-danger" })
</div>

<div class="mb-2">
    @Html.LabelFor(m => m.DateOfBirth)
    @Html.TextBoxFor(m => m.DateOfBirth, "{0:yyyy-MM-dd}", new { @class = "form-control", type = "date" })
    @Html.ValidationMessageFor(m => m.DateOfBirth, "", new { @class = "text-danger" })
</div>

<div class="mb-2">
    @Html.LabelFor(m => m.Gender)
    @Html.TextBoxFor(m => m.Gender, new { @class = "form-control" })
    @Html.ValidationMessageFor(m => m.Gender, "", new { @class = "text-danger" })
</div>

<div class="mb-2">
    @Html.LabelFor(m => m.PhoneNumber)
    @Html.TextBoxFor(m => m.PhoneNumber, new { @class = "form-control" })
    @Html.ValidationMessageFor(m => m.PhoneNumber, "", new { @class = "text-danger" })
</div>

<div class="mb-2">
    @Html.LabelFor(m => m.Email)
    @Html.TextBoxFor(m => m.Email, new { @class = "form-control" })
    @Html.ValidationMessageFor(m => m.Email, "", new { @class = "text-danger" })
</div>

<div class="mb-2">
    @Html.LabelFor(m => m.InsuranceId)
    @Html.TextBoxFor(m => m.InsuranceId, new { @class = "form-control" })
    @Html.ValidationMessageFor(m => m.InsuranceId, "", new { @class = "text-danger" })
</div>

        <button type="submit" class="btn btn-success">Save</button>

        <a href="@Url.Action("Index", "Patient")" class="btn btn-secondary">
            Back
        </a>
    }
</div>