@model HealthCare.Shared.DTOs.Patient.PatientDto

@{
    ViewBag.Title = "Patient Profile";
}

<div class="container py-4">

    <h2 class="fw-bold mb-4">Patient Profile</h2>

    <div class="card shadow-sm">
        <div class="card-body">

            <table class="table table-bordered">
                <tr><th>ID</th><td>@Model.PatientId</td></tr>
                <tr><th>Full Name</th><td>@Model.FullName</td></tr>
                <tr><th>DOB</th><td>@Model.DateOfBirth.ToShortDateString()</td></tr>
                <tr><th>Gender</th><td>@Model.Gender</td></tr>
                <tr><th>Phone</th><td>@Model.PhoneNumber</td></tr>
                <tr><th>Email</th><td>@Model.Email</td></tr>
                <tr><th>Insurance</th><td>@Model.InsuranceId</td></tr>
                <tr><th>Created</th><td>@Model.CreatedDate</td></tr>
            </table>

            <a href="@Url.Action("Edit", "Patient", new { id = Model.PatientId })"
               class="btn btn-warning">
                Edit
            </a>

            <a href="@Url.Action("Index", "Patient")"
               class="btn btn-secondary">
                Back
            </a>

        </div>
    </div>
</div>