@model HealthCare.Shared.DTOs.Patient.PatientDto

@{
    var maxDate = DateTime.Today.ToString("yyyy-MM-dd");
}

<div id="editFormContainer">
    @using (Html.BeginForm("Edit", "Patient", FormMethod.Post, new { id = "editForm" }))
    {
        @Html.AntiForgeryToken()
        @Html.HiddenFor(m => m.PatientId)

        <!-- ✅ Validation -->
        @Html.ValidationSummary(true, "", new { @class = "alert alert-danger" })

        <div class="row g-3">

            <!-- ✅ Full Name -->
            <div class="col-md-6">
                @Html.LabelFor(m => m.FullName, new { @class = "form-label fw-semibold" })

                @Html.TextBoxFor(m => m.FullName, new
                {
                    @class = "form-control",
                    required = "required",
                    minlength = "3",
                    maxlength = "100"
                })

                @Html.ValidationMessageFor(m => m.FullName, "", new { @class = "text-danger" })
            </div>

            <!-- ✅ Email -->
            <div class="col-md-6">
                @Html.LabelFor(m => m.Email, new { @class = "form-label fw-semibold" })

                @Html.TextBoxFor(m => m.Email, new
                {
                    @class = "form-control",
                    type = "email",
                    required = "required",
                    maxlength = "100"
                })

                @Html.ValidationMessageFor(m => m.Email, "", new { @class = "text-danger" })
            </div>

            <!-- ✅ Phone -->
            <div class="col-md-6">
                @Html.LabelFor(m => m.PhoneNumber, new { @class = "form-label fw-semibold" })

                @Html.TextBoxFor(m => m.PhoneNumber, new
                {
                    @class = "form-control",
                    pattern = "[0-9]{10}",
                    maxlength = "10",
                    required = "required"
                })

                @Html.ValidationMessageFor(m => m.PhoneNumber, "", new { @class = "text-danger" })
            </div>

            <!-- ✅ Gender -->
            <div class="col-md-6">
                @Html.LabelFor(m => m.Gender, new { @class = "form-label fw-semibold" })

                @Html.DropDownListFor(m => m.Gender,
                    new List<SelectListItem>
                    {
                        new SelectListItem { Text = "Male", Value = "Male" },
                        new SelectListItem { Text = "Female", Value = "Female" },
                        new SelectListItem { Text = "Other", Value = "Other" }
                    },
                    "Select Gender",
                    new
                    {
                        @class = "form-select",
                        required = "required"
                    })

                @Html.ValidationMessageFor(m => m.Gender, "", new { @class = "text-danger" })
            </div>

            <!-- ✅ Date of Birth -->
            <div class="col-md-6">
                @Html.LabelFor(m => m.DateOfBirth, new { @class = "form-label fw-semibold" })

                @Html.TextBoxFor(m => m.DateOfBirth, "{0:yyyy-MM-dd}", new
                {
                    @class = "form-control",
                    type = "date",
                    max = maxDate,
                    required = "required"
                })

                @Html.ValidationMessageFor(m => m.DateOfBirth, "", new { @class = "text-danger" })
            </div>

            <!-- ✅ Insurance -->
            <div class="col-md-6">
                @Html.LabelFor(m => m.InsuranceId, new { @class = "form-label fw-semibold" })

                @Html.TextBoxFor(m => m.InsuranceId, new
                {
                    @class = "form-control",
                    maxlength = "50"
                })

                @Html.ValidationMessageFor(m => m.InsuranceId, "", new { @class = "text-danger" })
            </div>

        </div>

        <!-- ✅ Actions -->
        <div class="mt-4 text-end">
            <button type="submit" class="btn btn-primary">
                Update
            </button>
        </div>
    }
</div>

<!-- ✅ AJAX SCRIPT -->
<script>
    $(document).ready(function () {

        $("#editForm").submit(function (e) {
            e.preventDefault();

            var form = $(this);

            $.ajax({
                url: form.attr("action"),
                type: "POST",
                data: form.serialize(),
                success: function (response) {

                    // ✅ SUCCESS
                    if (response && response.success) {
                        alert("Patient updated successfully");
                        location.reload();
                        return;
                    }

                    // ✅ VALIDATION ERROR
                    $("#editFormContainer").html(response);
                },
                error: function () {
                    alert("Something went wrong");
                }
            });
        });

    });
</script>