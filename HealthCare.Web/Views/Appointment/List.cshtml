@model HealthCare.Shared.PagedResult<HealthCare.Shared.DTOs.Appointment.AppointmentDto>

@{
    ViewBag.Title = "Appointment List";

    int currentPage = Model.PageNumber;
    int totalPages = Model.TotalPages;
}

<div class="container-fluid">

    <!-- Header -->
    <div class="mb-4">
        <h2 class="fw-bold mb-1">Appointment List</h2>
        <p class="text-muted mb-0">
            View and manage appointments.
        </p>
    </div>

    <!-- ✅ FILTER -->
    <!-- ✅ SEARCH SECTION -->
    <div class="mb-4 d-flex flex-wrap gap-3">

        <!-- ✅ Search by Patient -->
        @using (Html.BeginForm("List", "Appointment", FormMethod.Get))
        {
            <div class="d-flex gap-2">
                <input type="number"
                       name="patientId"
                       class="form-control"
                       placeholder="Enter Patient ID"
                       style="width:180px;" />

                <button type="submit" class="btn btn-primary">
                    Search Patient
                </button>
            </div>
        }

        <!-- ✅ Search by Doctor -->
        @using (Html.BeginForm("Today", "Appointment", FormMethod.Get))
        {
            <div class="d-flex gap-2">
                <input type="number"
                       name="doctorId"
                       class="form-control"
                       placeholder="Enter Doctor ID"
                       style="width:180px;" />

                <button type="submit" class="btn btn-success">
                    Search Doctor
                </button>
            </div>
        }

        @if (!string.IsNullOrEmpty(Request["patientId"]))
        {
            <!-- ✅ FILTER -->
            using (Html.BeginForm("List", "Appointment", FormMethod.Get))
            {
                <div class="d-flex gap-2">

                    <!-- ✅ Keep patientId hidden -->
                    <input type="hidden" name="patientId" value="@Request["patientId"]" />

                    <!-- ✅ Status filter -->
                    <select name="status" class="form-select" style="width:180px;">
                        <option value="">All Status</option>
                        <option value="Pending" @(Request["status"] == "Pending" ? "selected" : "")>Pending</option>
                        <option value="Confirmed" @(Request["status"] == "Confirmed" ? "selected" : "")>Confirmed</option>
                        <option value="Cancelled" @(Request["status"] == "Cancelled" ? "selected" : "")>Cancelled</option>
                    </select>

                    <button type="submit" class="btn btn-primary">
                        Filter
                    </button>

                </div>
            }
        }
        else
        {
            <!-- ✅ USER GUIDANCE -->
            <div class="alert alert-info">
                Please enter a Patient ID to view and filter appointments.
            </div>
        }

    </div>

    <!-- Table -->
    <div class="card border-0 shadow-sm rounded-4">
        <div class="card-body p-0">

            <div class="table-responsive">
                @Html.Partial("_AppointmentTable", Model.Items)
            </div>

        </div>
    </div>

    <!-- ✅ PAGINATION -->
    <nav class="mt-4">
        <ul class="pagination justify-content-center">

            <!-- Previous -->
            <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                <a class="page-link"
                   href="@Url.Action("List", new { pageNumber = currentPage - 1 })">
                    Previous
                </a>
            </li>

            <!-- Page numbers -->
            @for (int i = 1; i <= totalPages; i++)
            {
                <li class="page-item @(i == currentPage ? "active" : "")">
                    <a class="page-link"
                       href="@Url.Action("List", new { pageNumber = i })">
                        @i
                    </a>
                </li>
            }

            <!-- Next -->
            <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                <a class="page-link"
                   href="@Url.Action("List", new { pageNumber = currentPage + 1 })">
                    Next
                </a>
            </li>

        </ul>
    </nav>

</div>

<script>
    document.addEventListener("DOMContentLoaded", function () {

        // ✅ Make it GLOBAL
        window.openCancelModal = function (id) {
            document.getElementById("cancelId").value = id;
            document.getElementById("cancelReason").value = "";

            var modal = new bootstrap.Modal(document.getElementById('cancelModal'));
            modal.show();
        };

        // ✅ Handle submit
        document.getElementById("cancelForm").addEventListener("submit", function (e) {

            var reason = document.getElementById("cancelReason").value;

            if (!reason || reason.trim() === "") {
                alert("Please enter a cancellation reason.");
                e.preventDefault();
                return;
            }

            document.getElementById("hiddenReason").value = reason;
        });

    });
</script>

@Html.Partial("_CancelModal")