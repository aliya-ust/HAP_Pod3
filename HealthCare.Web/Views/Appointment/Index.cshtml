@model HealthCare.Shared.PagedResult<HealthCare.Shared.DTOs.Appointment.AppointmentDto>

@{
    ViewBag.Title = "Appointment Management";

    int? patientId = Request.QueryString["patientId"] != null
        ? Convert.ToInt32(Request.QueryString["patientId"]) : (int?)null;

    int currentPage = Model?.PageNumber ?? 1;
    int totalPages = Model != null && Model.PageSize > 0
        ? (int)Math.Ceiling((double)Model.TotalCount / Model.PageSize)
        : 1;
}

<div class="container mt-4">

    <h2 class="mb-4">Appointment Management</h2>

    <!-- SEARCH -->
    <form method="get" action="@Url.Action("List", "Appointment")" class="card p-3 mb-4">
        <div class="row">

            <div class="col-md-6">
                <input type="number" class="form-control"
                       name="patientId"
                       value="@patientId"
                       placeholder="Enter Patient ID" />
            </div>

            <div class="col-md-6">
                <button type="submit" class="btn btn-primary">Search</button>

                <a href="@Url.Action("Index", "Appointment")"
                   class="btn btn-secondary">
                    Reset
                </a>

                <a href="@Url.Action("Book", "Appointment")"
                   class="btn btn-success">
                    Book Appointment
                </a>
            </div>

        </div>
    </form>

    <!-- TABLE -->
    <table class="table table-bordered">
        <thead class="table-dark">
            <tr>
                <th>ID</th>
                <th>Patient</th>
                <th>Doctor</th>
                <th>Date</th>
                <th>Slot</th>
                <th>Status</th>
                <th>Actions</th>
            </tr>
        </thead>

        <tbody>
            @if (Model?.Items != null && Model.Items.Any())
            {
                foreach (var item in Model.Items)
                {
                    <tr>
                        <td>@item.AppointmentId</td>
                        <td>@item.PatientId</td>
                        <td>@item.DoctorId</td>
                        <td>@item.ScheduledDate.ToString("yyyy-MM-dd")</td>
                        <td>@item.TimeSlot</td>

                        <td>
                            <span class="badge
                                @(item.Status == "Confirmed" ? "bg-success" :
                                  item.Status == "Cancelled" ? "bg-danger" :
                                  "bg-warning")">
                                @item.Status
                            </span>
                        </td>

                        <td>

                            
                            @if (item.Status == "Pending")
                            {
                                <form method="post"
                                      action="@Url.Action("Confirm","Appointment")"
                                      style="display:inline;">
                                    @Html.AntiForgeryToken()

                                    <input type="hidden" name="id" value="@item.AppointmentId" />
                                    <input type="hidden" name="patientId" value="@item.PatientId" />

                                    <button class="btn btn-sm btn-success">
                                        Confirm
                                    </button>
                                </form>
                            }

                          
                            @if (item.Status != "Cancelled" && item.Status != "Completed")
                            {
                                <button class="btn btn-sm btn-danger"
                                        onclick="cancelAppointment(@item.AppointmentId, @item.PatientId)">
                                    Cancel
                                </button>
                            }

                            
                            @if (item.Status == "Confirmed")
                            {
                                <a href="@Url.Action("Create", "HealthRecord",
                new { appointmentId = item.AppointmentId })"
                                   class="btn btn-sm btn-primary">
                                    Add Record
                                </a>
                            }

                            
                            @if (item.Status == "Completed")
                            {
                                <a href="@Url.Action("List", "HealthRecord",
                new { patientId = item.PatientId })"
                                   class="btn btn-sm btn-info">
                                    View Record
                                </a>
                            }

                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="7" class="text-center text-muted">
                        No appointments found
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <!-- PAGINATION -->
    @if (Model != null && totalPages > 1)
    {
        <nav>
            <ul class="pagination justify-content-center">

                <!-- PREV -->
                <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                    <a class="page-link"
                       href="@Url.Action("Index", "Appointment", new {
                            patientId = patientId,
                            pageNumber = currentPage - 1
                       })">
                        Prev
                    </a>
                </li>

                <!-- PAGE NUMBERS -->
                @for (int i = 1; i <= totalPages; i++)
                {
                    <li class="page-item @(i == currentPage ? "active" : "")">
                        <a class="page-link"
                           href="@Url.Action("Index", "Appointment", new {
                                patientId = patientId,
                                pageNumber = i
                           })">
                            @i
                        </a>
                    </li>
                }

                <!-- NEXT -->
                <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                    <a class="page-link"
                       href="@Url.Action("Index", "Appointment", new {
                            patientId = patientId,
                            pageNumber = currentPage + 1
                       })">
                        Next
                    </a>
                </li>

            </ul>
        </nav>
    }

</div>

<!-- CANCEL SCRIPT -->
<script>
    function cancelAppointment(id, patientId) {

        if (confirm("Are you sure you want to cancel this appointment?")) {

            var form = document.createElement("form");
            form.method = "POST";
            form.action = '@Url.Action("Cancel", "Appointment")';

            form.innerHTML =
                '<input type="hidden" name="id" value="' + id + '" />' +
                '<input type="hidden" name="patientId" value="' + patientId + '" />' +
                '<input type="hidden" name="reason" value="Cancelled by user" />' +
                '@Html.AntiForgeryToken()';

            document.body.appendChild(form);
            form.submit();
        }
    }
</script>