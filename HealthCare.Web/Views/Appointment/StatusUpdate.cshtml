@model HospitalManagement.ViewModels.AppointmentStatusUpdateViewModel

@{
    ViewBag.Title = "Update Appointment Status";
}

<div class="page-card">
    <div class="page-header">
        <div>
            <h2 class="page-title">Update Appointment Status</h2>
            <div class="page-subtitle">Confirm, cancel or complete appointment.</div>
        </div>
    </div>

    <div class="profile-grid">
        <div class="profile-item">
            <div class="profile-label">Patient</div>
            <div class="profile-value">@Model.PatientName</div>
        </div>

        <div class="profile-item">
            <div class="profile-label">Doctor</div>
            <div class="profile-value">@Model.DoctorName</div>
        </div>

        <div class="profile-item">
            <div class="profile-label">Date</div>
            <div class="profile-value">@Model.ScheduledDate.ToString("dd-MMM-yyyy")</div>
        </div>

        <div class="profile-item">
            <div class="profile-label">Time Slot</div>
            <div class="profile-value">@Model.TimeSlot</div>
        </div>

        <div class="profile-item">
            <div class="profile-label">Current Status</div>
            <div class="profile-value">@Html.Partial("_StatusBadge", Model.Status)</div>
        </div>
    </div>

    <hr />

    @using (Html.BeginForm("UpdateStatus", "Appointments", FormMethod.Post))
    {
        @Html.AntiForgeryToken()
        @Html.HiddenFor(m => m.AppointmentId)

        <div class="form-group">
            @Html.LabelFor(m => m.Status)
            @Html.DropDownListFor(m => m.Status,
                new SelectList(new[] { "Confirmed", "Cancelled", "Completed" }),
                "Select Status",
                new { @class = "form-control", id = "statusDropdown" })
            @Html.ValidationMessageFor(m => m.Status, "", new { @class = "text-danger" })
        </div>

        <div class="form-group" id="cancelReasonBox" style="display:none;">
            @Html.LabelFor(m => m.CancellationReason)
            @Html.TextAreaFor(m => m.CancellationReason, new { @class = "form-control", rows = "4", placeholder = "Enter cancellation reason" })
            @Html.ValidationMessageFor(m => m.CancellationReason, "", new { @class = "text-danger" })
        </div>

        <button type="button"
                class="btn btn-primary"
                onclick="submitStatusWithConfirmation()">
            Save Status
        </button>

        @Url.Action(" class="btn btn - default">
            Cancel
        </a>
    }
</div>

@section scripts {
    @Scripts.Render("~/bundles/jqueryval")

    <script>
        $("#statusDropdown").on("change", function () {
            var status = $(this).val();

            if (status === "Cancelled") {
                $("#cancelReasonBox").show();
            } else {
                $("#cancelReasonBox").hide();
            }
        });

        function submitStatusWithConfirmation() {
            var selectedStatus = $("#statusDropdown").val();

            if (!selectedStatus) {
                alert("Please select a status.");
                return;
            }

            if (selectedStatus === "Cancelled") {
                var reason = $("#CancellationReason").val();

                if (!reason || reason.trim() === "") {
                    alert("Cancellation reason is required.");
                    return;
                }
            }

            var message = "Are you sure you want to update this appointment to " + selectedStatus + "?";

            if (confirm(message)) {
                $("form").submit();
            }
        }
    </script>
}