@model HealthCare.Shared.DTOs.Appointment.AppointmentDto

@{
    ViewBag.Title = "Book Appointment";
}

<div class="container-fluid">

    <div class="mb-4">
        <h2 class="fw-bold">Book Appointment</h2>
        <p class="text-muted">Schedule an appointment with a doctor.</p>
    </div>

    <div class="card border-0 shadow-sm rounded-4">
        <div class="card-body p-4 p-md-5">

            @using (Html.BeginForm("Book", "Appointment", FormMethod.Post, new { id = "appointmentForm" }))
            {
                @Html.AntiForgeryToken()

                <div class="row g-4">

                    <!-- ✅ Patient -->
                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Patient ID</label>

                        @Html.TextBoxFor(m => m.PatientId, new
                        {
                            @class = "form-control",
                            required = "required"
                        })

                        @Html.ValidationMessageFor(m => m.PatientId, "", new { @class = "text-danger" })
                    </div>

                    <!-- ✅ Date -->
                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Select Date</label>

                        @Html.TextBoxFor(m => m.ScheduledDate, new
                        {
                            type = "date",
                            @class = "form-control",
                            id = "date",
                            min = DateTime.Now.ToString("yyyy-MM-dd"),
                            required = "required"
                        })

                        @Html.ValidationMessageFor(m => m.ScheduledDate, "", new { @class = "text-danger" })
                    </div>

                    <!-- ✅ Specialization -->
                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Specialization</label>

                        <select id="specialization" class="form-select" required>
                            <option value="">-- Select Specialization --</option>
                            <option value="Cardiologist">Cardiology</option>
                            <option value="Dermatologist">Dermatology</option>
                            <option value="Neurologist">Neurologist</option>
                            <option value="Orthopedic">Orthopedic</option>
                            <option value="Pediatrician">Pediatrician</option>
                        </select>
                    </div>

                    <!-- ✅ Doctor -->
                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Doctor</label>

                        @Html.DropDownListFor(m => m.DoctorId,
                            new List<SelectListItem>(),
                            "-- Select Doctor --",
                            new
                            {
                                @class = "form-select",
                                id = "doctor",
                                required = "required",
                                disabled = "disabled"
                            })

                        @Html.ValidationMessageFor(m => m.DoctorId, "", new { @class = "text-danger" })
                    </div>

                    <!-- ✅ Time Slot -->
                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Time Slot</label>

                        @Html.DropDownListFor(m => m.TimeSlot,
                            new List<SelectListItem>(),
                            "-- Select Time Slot --",
                            new
                            {
                                @class = "form-select",
                                id = "timeslot",
                                required = "required",
                                disabled = "disabled"
                            })

                        @Html.ValidationMessageFor(m => m.TimeSlot, "", new { @class = "text-danger" })
                    </div>

                </div>

                <div class="mt-5 text-end">
                    <a href="@Url.Action("Index", "Appointment")"
                       class="btn btn-secondary">Cancel</a>

                    <button type="submit" class="btn btn-primary">
                        Book Appointment
                    </button>
                </div>
            }

        </div>
    </div>

</div>

<script>
    document.addEventListener("DOMContentLoaded", function () {

        // ✅ Load doctors
        document.getElementById("specialization").addEventListener("change", function () {

            var specialization = this.value;
            var doctor = document.getElementById("doctor");

            doctor.disabled = true;
            doctor.innerHTML = '<option>Loading doctors...</option>';

            fetch('https://localhost:44373/api/doctors?specialization=' + specialization)
                .then(res => res.json())
                .then(data => {

                    doctor.disabled = false;
                    doctor.innerHTML = '<option value="">-- Select Doctor --</option>';

                    data.Items.forEach(d => {
                        doctor.innerHTML += `<option value="${d.DoctorId}">${d.FullName}</option>`;
                    });

                })
                .catch(() => {
                    doctor.innerHTML = '<option>Error loading doctors</option>';
                });
        });

        // ✅ Load slots
        document.getElementById("doctor").addEventListener("change", loadSlots);
        document.getElementById("date").addEventListener("change", loadSlots);

        function loadSlots() {

            var doctorId = document.getElementById("doctor").value;
            var date = document.getElementById("date").value;
            var slot = document.getElementById("timeslot");

            if (!doctorId || !date) return;

            slot.disabled = true;
            slot.innerHTML = '<option>Loading time slots...</option>';

            fetch(`https://localhost:44373/api/appointments/slots?doctorId=${doctorId}&date=${date}`)
                .then(res => res.json())
                .then(data => {

                    slot.disabled = false;
                    slot.innerHTML = '<option value="">-- Select Time Slot --</option>';

                    data.forEach(s => {
                        slot.innerHTML += `<option value="${s}">${s}</option>`;
                    });

                })
                .catch(() => {
                    slot.innerHTML = '<option>Error loading time slots</option>';
                });
        }

    });
</script>