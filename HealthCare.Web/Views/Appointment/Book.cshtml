@model HealthCare.Shared.DTOs.Appointment.AppointmentDto

@{
    ViewBag.Title = "Book Appointment";
}

<div class="container mt-4">

    <h2>Book Appointment</h2>

    @using (Html.BeginForm("Book", "Appointment", FormMethod.Post))
    {
        @Html.AntiForgeryToken()

        @Html.ValidationSummary(true, "", new { @class = "text-danger" })

        <div class="card p-4">
            <div class="row">

                <!-- Patient -->
                <div class="col-md-6 mb-3">
                    <label>Patient ID</label>
                    @Html.TextBoxFor(m => m.PatientId,
                        new { @class = "form-control" })
                    @Html.ValidationMessageFor(m => m.PatientId, "",
                        new { @class = "text-danger" })
                </div>

                <!-- Date -->
                <div class="col-md-6 mb-3">
                    <label>Scheduled Date</label>
                    @Html.TextBoxFor(m => m.ScheduledDate, new
                    {
                        @class = "form-control",
                        type = "date",
                        id = "date",
                        min = DateTime.Now.ToString("yyyy-MM-dd")
                    })
                    @Html.ValidationMessageFor(m => m.ScheduledDate, "",
                        new { @class = "text-danger" })
                </div>

                <!--Specialization -->
                <div class="col-md-6 mb-3">
                    <label>Specialisation</label>
                    <select id="specialisation" class="form-control">
                        <option value="">-- Select Specialization --</option>
                        <option value="Cardiology">Cardiology</option>
                        <option value="Dermatology">Dermatology</option>
                        <option value="Neurology">Neurology</option>
                        <option value="Orthopedics">Orthopedics</option>
                    </select>
                </div>

                <!-- Doctor -->
                <div class="col-md-6 mb-3">
                    <label>Doctor</label>
                    <select id="doctor" name="DoctorId" class="form-control" disabled>
                        <option>-- Select Doctor --</option>
                    </select>
                    @Html.ValidationMessageFor(m => m.DoctorId, "",
                        new { @class = "text-danger" })
                </div>

                <!-- Slot -->
                <div class="col-md-6 mb-3">
                    <label>Time Slot</label>
                    <select id="timeslot" name="TimeSlot" class="form-control" disabled>
                        <option>-- Select Time Slot --</option>
                    </select>
                    @Html.ValidationMessageFor(m => m.TimeSlot, "",
                        new { @class = "text-danger" })
                </div>

            </div>

            <button type="submit" class="btn btn-success mt-3">
                Book Appointment
            </button>

            <a href="@Url.Action("Index", "Appointment")"
               class="btn btn-secondary mt-3">
                Back
            </a>
        </div>
    }

</div>

<!--  SCRIPT -->
<script>


    document.getElementById("specialisation").addEventListener("change", function () {

        var specialisation = this.value;
        var doctor = document.getElementById("doctor");

        if (!specialisation) {
            doctor.innerHTML = '<option>-- Select Doctor --</option>';
            doctor.disabled = true;
            return;
        }

        doctor.disabled = true;
        doctor.innerHTML = '<option>Loading doctors...</option>';

      
        fetch('https://localhost:44326/api/doctors?specialisation=' + specialisation)
            .then(res => {
                if (!res.ok)
                    throw new Error("API error: " + res.status);

                return res.json();
            })
            .then(data => {

                doctor.disabled = false;
                doctor.innerHTML = '<option value="">-- Select Doctor --</option>';

                if (data.Items && data.Items.length > 0) {
                    data.Items.forEach(d => {
                        doctor.innerHTML += `<option value="${d.DoctorId}">${d.FullName}</option>`;
                    });
                } else {
                    doctor.innerHTML = '<option>No doctors found</option>';
                }
            })
            .catch(err => {
                console.log("Doctor fetch error:", err); // ✅ see error in console
                doctor.innerHTML = '<option>Error loading doctors</option>';
            });
    });


   
    document.getElementById("doctor").addEventListener("change", loadSlots);
    document.getElementById("date").addEventListener("change", loadSlots);

    function loadSlots() {

        var doctorId = document.getElementById("doctor").value;
        var date = document.getElementById("date").value;
        var slot = document.getElementById("timeslot");

        if (!doctorId || !date) return;

        slot.disabled = true;
        slot.innerHTML = '<option>Loading slots...</option>';

        fetch(`https://localhost:44326/api/appointments/slots?doctorId=${doctorId}&date=${date}`)
            .then(res => res.json())
            .then(data => {

                slot.disabled = false;
                slot.innerHTML = '<option value="">-- Select Time Slot --</option>';

                if (data.length > 0) {
                    data.forEach(s => {
                        slot.innerHTML += `<option value="${s}">${s}</option>`;
                    });
                } else {
                    slot.innerHTML = '<option>No slots available</option>';
                }
            })
            .catch(() => {
                slot.innerHTML = '<option>Error loading slots</option>';
            });
    }

</script>