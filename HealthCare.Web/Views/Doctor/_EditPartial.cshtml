@model HealthCare.Shared.DTOs.Doctor.DoctorDto

<div id="editDoctorFormContainer">
    @using (Html.BeginForm("Edit", "Doctor", FormMethod.Post, new { id = "editDoctorForm" }))
    {
        @Html.AntiForgeryToken()
        @Html.HiddenFor(m => m.DoctorId)

        <div class="row g-3">

            <!-- ✅ Full Name -->
            <div class="col-md-6">
                @Html.LabelFor(m => m.FullName, new { @class = "form-label fw-semibold" })

                @Html.TextBoxFor(m => m.FullName, new
                {
                    @class = "form-control",
                    required = "required",
                    maxlength = "100"
                })

                @Html.ValidationMessageFor(m => m.FullName, "", new { @class = "text-danger" })
            </div>

            <!-- ✅ Specialisation -->
            <div class="col-md-6">
                @Html.LabelFor(m => m.Specialisation, new { @class = "form-label fw-semibold" })

                @Html.TextBoxFor(m => m.Specialisation, new
                {
                    @class = "form-control",
                    required = "required",
                    maxlength = "50"
                })

                @Html.ValidationMessageFor(m => m.Specialisation, "", new { @class = "text-danger" })
            </div>

            <!-- ✅ Experience -->
            <div class="col-md-6">
                @Html.LabelFor(m => m.YearsOfExperience, new { @class = "form-label fw-semibold" })

                @Html.TextBoxFor(m => m.YearsOfExperience, new
                {
                    @class = "form-control",
                    type = "number",
                    min = "0",
                    max = "60",
                    required = "required"
                })

                @Html.ValidationMessageFor(m => m.YearsOfExperience, "", new { @class = "text-danger" })
            </div>

            <!-- ✅ Fee -->
            <div class="col-md-6">
                @Html.LabelFor(m => m.ConsultationFee, new { @class = "form-label fw-semibold" })

                @Html.TextBoxFor(m => m.ConsultationFee, new
                {
                    @class = "form-control",
                    type = "number",
                    min = "0",
                    required = "required"
                })

                @Html.ValidationMessageFor(m => m.ConsultationFee, "", new { @class = "text-danger" })
            </div>

        </div>

        <!-- ✅ Actions -->
        <div class="mt-4 text-end">
            <button type="submit" class="btn btn-primary">
                Update Doctor
            </button>
        </div>
    }
</div>

<!-- ✅ AJAX SCRIPT -->
<script>
    $(document).ready(function () {

        $("#editDoctorForm").submit(function (e) {
            e.preventDefault();

            var form = $(this);

            $.ajax({
                url: form.attr("action"),
                type: "POST",
                data: form.serialize(),
                success: function (response) {

                    // ✅ SUCCESS
                    if (response && response.success) {
                        alert("Doctor updated successfully");
                        location.reload();
                        return;
                    }

                    // ✅ VALIDATION ERROR (reload partial)
                    $("#editDoctorFormContainer").html(response);

                    // 🔥 IMPORTANT: rebind validation
                    $.validator.unobtrusive.parse("#editDoctorFormContainer");
                },
                error: function () {
                    alert("Something went wrong");
                }
            });
        });

    });
</script>