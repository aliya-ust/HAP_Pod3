@model HealthCare.Shared.DTOs.Doctor.DoctorDto

<div class="container mt-4">

    <h3>Edit Doctor</h3>

    @Html.ValidationSummary(true, "", new { @class = "text-danger" })

    @using (Html.BeginForm())
    {
        @Html.AntiForgeryToken()

        @Html.HiddenFor(m => m.DoctorId)

        <!-- NAME -->
        <div class="form-group">
            <label>Name</label>
            @Html.TextBoxFor(m => m.FullName, new
            {
                @class = "form-control",
                pattern = @"^[a-zA-Z\s]+$",
                title = "Only letters allowed"
            })
            @Html.ValidationMessageFor(m => m.FullName, "", new { @class = "text-danger" })
        </div>

        <!-- SPECIALISATION DROPDOWN -->
        <div class="form-group">
            <label>Specialisation</label>
            @Html.DropDownListFor(m => m.Specialisation,
                new SelectList(new[] { "Cardiology", "Dermatology", "Neurology", "Orthopedics" }, Model.Specialisation),
                "-- Select Specialisation --",
                new { @class = "form-control" })
            @Html.ValidationMessageFor(m => m.Specialisation, "", new { @class = "text-danger" })
        </div>

        <!-- EXPERIENCE -->
        <div class="form-group">
            <label>Experience</label>
            @Html.TextBoxFor(m => m.YearsOfExperience, new
            {
                @class = "form-control",
                type = "number",
                min = "0",
                max = "50"
            })
            @Html.ValidationMessageFor(m => m.YearsOfExperience, "", new { @class = "text-danger" })
        </div>

        <!-- FEE -->
        <div class="form-group">
            <label>Fee</label>
            @Html.TextBoxFor(m => m.ConsultationFee, new
            {
                @class = "form-control",
                type = "number",
                min = "0"
            })
            @Html.ValidationMessageFor(m => m.ConsultationFee, "", new { @class = "text-danger" })
        </div>

        <button type="submit" class="btn btn-success mt-3">Save</button>
    }

</div>
``