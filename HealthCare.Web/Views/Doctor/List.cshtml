@using HealthAppWeb.Models.ViewModels
@using HealthAppWeb.Models.Helpers

@model PagedResult<DoctorListViewModel>

@{
    ViewBag.Title = "Doctors List";
    var totalPages = (int)Math.Ceiling((double)Model.TotalCount / Model.PageSize);
}

<div class="container-fluid">

    <!-- Header -->
    <div class="mb-4">

        <nav class="mb-2">
            <ol class="breadcrumb mb-1">
                <li class="breadcrumb-item">
                    <a href="@Url.Action("Index", "Doctor")" class="text-decoration-none">
                        Doctor Management
                    </a>
                </li>
                <li class="breadcrumb-item active">Doctors List</li>
            </ol>
        </nav>

        <div class="d-flex justify-content-between align-items-center">
            <div>
                <h2 class="fw-bold mb-1">Doctors List</h2>
                <p class="text-muted mb-0">
                    View all registered doctors and their details.
                </p>
            </div>

            <a href="@Url.Action("Add", "Doctor")"
               class="btn btn-success rounded-3">
                + Add Doctor
            </a>
        </div>
    </div>

    <!-- Table -->
    <div class="card border-0 shadow-sm rounded-4">
        <div class="card-body p-0">

            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">

                    <thead class="table-light">
                        <tr>
                            <th class="px-4 py-3">Doctor ID</th>
                            <th class="px-4 py-3">Doctor Name</th>
                            <th class="px-4 py-3">Specialisation</th>
                            <th class="px-4 py-3">Experience</th>
                            <th class="px-4 py-3">Fee</th>
                            <th class="px-4 py-3">Status</th>
                            <th class="px-4 py-3">Actions</th>
                        </tr>
                    </thead>

                    <tbody>

                        @if (Model.Items.Any())
                        {
                            foreach (var doctor in Model.Items)
                            {
                                <tr>
                                    <td class="px-4 py-3">@doctor.DoctorId</td>

                                    <td class="px-4 py-3">
                                        <a href="@Url.Action("Profile", "Doctor", new { id = doctor.DoctorId })"
                                           class="fw-semibold text-decoration-none">
                                            @doctor.FullName
                                        </a>
                                    </td>

                                    <td class="px-4 py-3 text-muted">
                                        @doctor.Specialisation
                                    </td>

                                    <td class="px-4 py-3">
                                        @doctor.YearsOfExperience Years
                                    </td>

                                    <td class="px-4 py-3">
                                        ₹@doctor.ConsultationFee
                                    </td>

                                    <td class="px-4 py-3">
                                        @if (doctor.IsActive)
                                        {
                                            <span class="badge rounded-pill bg-success px-3 py-2">
                                                Active
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge rounded-pill bg-danger px-3 py-2">
                                                Inactive
                                            </span>
                                        }
                                    </td>

                                    <td class="px-4 py-3">
                                        <a href="@Url.Action("Profile", "Doctor", new { id = doctor.DoctorId })"
                                           class="btn btn-info btn-sm me-1">
                                            Profile
                                        </a>

                                        <a href="@Url.Action("Edit", "Doctor", new { id = doctor.DoctorId })"
                                           class="btn btn-warning btn-sm">
                                            Edit
                                        </a>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="7" class="text-center py-4 text-muted">
                                    No doctors found.
                                </td>
                            </tr>
                        }

                    </tbody>

                </table>
            </div>

        </div>
    </div>

    <!-- ✅ Pagination -->
    <nav class="mt-4">
        <ul class="pagination justify-content-center">

            <!-- Previous -->
            <li class="page-item @(Model.PageNumber == 1 ? "disabled" : "")">
                <a class="page-link"
                   href="@Url.Action("List", new { page = Model.PageNumber - 1 })">
                    Previous
                </a>
            </li>

            <!-- Page Numbers -->
            @for (int i = 1; i <= totalPages; i++)
            {
                <li class="page-item @(i == Model.PageNumber ? "active" : "")">
                    <a class="page-link"
                       href="@Url.Action("List", new { page = i })">
                        @i
                    </a>
                </li>
            }

            <!-- Next -->
            <li class="page-item @(Model.PageNumber == totalPages ? "disabled" : "")">
                <a class="page-link"
                   href="@Url.Action("List", new { page = Model.PageNumber + 1 })">
                    Next
                </a>
            </li>

        </ul>
    </nav>

</div>