@model HealthCare.Shared.DTOs.Doctor.DoctorDto

<div class="container mt-4">

    <h3>Doctor Profile</h3>

    <table class="table table-bordered mt-3">

        <tr><th>ID</th><td>@Model.DoctorId</td></tr>
        <tr><th>Name</th><td>@Model.FullName</td></tr>
        <tr><th>Specialisation</th><td>@Model.Specialisation</td></tr>
        <tr><th>Experience</th><td>@Model.YearsOfExperience</td></tr>
        <tr><th>Fee</th><td>@Model.ConsultationFee</td></tr>

    </table>

    <h4>Available Slots</h4>
    <ul>
        @foreach (var slot in Model.DoctorAvailableSlots ?? new List<string>())
        {
            <li>@slot</li>
        }
    </ul>

    <h4>Leave Dates</h4>
    <ul>
        @foreach (var leave in Model.LeaveDates ?? new List<DateTime>())
        {
            <li>@leave.ToShortDateString()</li>
        }
    </ul>

</div>