@model HealthCare.Shared.DTOs.Doctor.DoctorDto

<div class="container">

    <!-- EADER -->
    <div class="text-center mb-3">
        <h4 class="fw-bold">@Model.FullName</h4>
        <span class="badge bg-primary">@Model.Specialisation</span>
    </div>

    <!-- BASIC INFO CARD -->
    <div class="card shadow-sm mb-3">
        <div class="card-body">

            <div class="row mb-2">
                <div class="col-6 fw-bold">Doctor ID</div>
                <div class="col-6">@Model.DoctorId</div>
            </div>

            <div class="row mb-2">
                <div class="col-6 fw-bold">Experience</div>
                <div class="col-6">@Model.YearsOfExperience yrs</div>
            </div>

            <div class="row mb-2">
                <div class="col-6 fw-bold">Consultation Fee</div>
                <div class="col-6">₹ @Model.ConsultationFee</div>
            </div>

        </div>
    </div>

    <!-- AVAILABLE SLOTS -->
    <div class="card shadow-sm mb-3">
        <div class="card-body">
            <h6 class="fw-bold mb-2">Available Slots</h6>

            @if (Model.DoctorAvailableSlots != null && Model.DoctorAvailableSlots.Any())
            {
                foreach (var slot in Model.DoctorAvailableSlots)
                {
                    <span class="badge bg-success me-1 mb-1">@slot</span>
                }
            }
            else
            {
                <p class="text-muted">No slots available</p>
            }
        </div>
    </div>

</div>