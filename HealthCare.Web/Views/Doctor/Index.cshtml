@model HealthCare.Shared.PagedResult<HealthCare.Shared.DTOs.Doctor.DoctorDto>

@{
    ViewBag.Title = "Doctor Management";
}

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

<!-- MODAL -->
<div class="modal fade" id="doctorModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content p-3">

            <div class="d-flex justify-content-between">
                <h4>Doctor Profile</h4>
                <button class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <hr />

            <div id="doctorContent"></div>

            <div class="mt-3 text-end">
                <a id="editDoctorBtn" class="btn btn-warning">
                    <i class="fa fa-edit"></i> Edit
                </a>

                <button id="deleteDoctorBtn" class="btn btn-danger">
                    <i class="fa fa-trash"></i> Delete
                </button>
            </div>

        </div>
    </div>
</div>

<div class="container mt-3">

    <!-- HEADER -->
    <div class="d-flex justify-content-between mb-3">
        <h3>Doctor Management</h3>

        <a href="@Url.Action("Register", "Doctor")" class="btn btn-primary">
            + Add Doctor
        </a>
    </div>

    <!-- SEARCH -->
    <div class="row mb-3">

        <div class="col-md-6">
            <input type="text" id="searchTerm" class="form-control"
                   placeholder="Search by ID or Name"
                   value="@Request["searchTerm"]" />
        </div>

        <div class="col-md-6">
            <select id="specialization" class="form-control">
                <option value="">-- Select Specialisation --</option>
                <option value="Cardiology" @(Request["specialization"] == "Cardiology" ? "selected" : "")>Cardiology</option>
                <option value="Dermatology" @(Request["specialization"] == "Dermatology" ? "selected" : "")>Dermatology</option>
                <option value="Neurology" @(Request["specialization"] == "Neurology" ? "selected" : "")>Neurology</option>
                <option value="Orthopedics" @(Request["specialization"] == "Orthopedics" ? "selected" : "")>Orthopedics</option>
            </select>
        </div>

    </div>

    <button class="btn btn-dark mb-3" onclick="searchDoctors()">Search</button>

    <!-- TABLE -->
    <table class="table table-bordered">
        <thead class="table-dark">
            <tr>
                <th>ID</th>
                <th>Name</th>
                <th>Specialisation</th>
                <th>Actions</th>
            </tr>
        </thead>

        <tbody>
            @if (Model?.Items != null && Model.Items.Any())
            {
                foreach (var doc in Model.Items)
                {
                    <tr>
                        <td>@doc.DoctorId</td>
                        <td>@doc.FullName</td>
                        <td>@doc.Specialisation</td>
                        <td>
                            <button class="btn btn-info btn-sm" onclick="showDoctor(@doc.DoctorId)">
                                <i class="fa fa-eye"></i>
                            </button>

                            <a class="btn btn-warning btn-sm"
                               href="@Url.Action("Edit", "Doctor", new { id = doc.DoctorId })">
                                <i class="fa fa-edit"></i>
                            </a>

                            <button class="btn btn-danger btn-sm"
                                    onclick="confirmDeleteDoctor(@doc.DoctorId)">
                                <i class="fa fa-trash"></i>
                            </button>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="4" class="text-center text-muted">No doctors found</td>
                </tr>
            }
        </tbody>
    </table>

    <!-- PAGINATION -->
    <nav class="mt-4">
        <ul class="pagination justify-content-center">

            <!-- Previous -->
            <li class="page-item @(Model.PageNumber == 1 ? "disabled" : "")">
                <a class="page-link"
                   href="@Url.Action("Index", "Doctor", new {
                        searchTerm = Request["searchTerm"],
                        specialization = Request["specialization"],
                        pageNumber = Model.PageNumber - 1
                   })">
                    Previous
                </a>
            </li>

            <!-- Page Numbers -->
            @for (int i = 1; i <= (int)Math.Ceiling((double)Model.TotalCount / Model.PageSize); i++)
            {
                <li class="page-item @(i == Model.PageNumber ? "active" : "")">
                    <a class="page-link"
                       href="@Url.Action("Index", "Doctor", new {
                            searchTerm = Request["searchTerm"],
                            specialization = Request["specialization"],
                            pageNumber = i
                       })">
                        @i
                    </a>
                </li>
            }

            <!-- Next -->
            <li class="page-item @(Model.PageNumber * Model.PageSize >= Model.TotalCount ? "disabled" : "")">
                <a class="page-link"
                   href="@Url.Action("Index", "Doctor", new {
                        searchTerm = Request["searchTerm"],
                        specialization = Request["specialization"],
                        pageNumber = Model.PageNumber + 1
                   })">
                    Next
                </a>
            </li>

        </ul>
    </nav>

</div>

<!-- SCRIPTS -->
<script>
    function searchDoctors() {
        var term = document.getElementById("searchTerm").value;
        var spec = document.getElementById("specialization").value;

        window.location.href =
            '/Doctor/Index?searchTerm=' + encodeURIComponent(term) +
            '&specialization=' + encodeURIComponent(spec);
    }

    function showDoctor(id) {
        fetch('/Doctor/Profile/' + id)
            .then(res => res.text())
            .then(html => {
                document.getElementById("doctorContent").innerHTML = html;

                document.getElementById("editDoctorBtn").href = '/Doctor/Edit/' + id;

                document.getElementById("deleteDoctorBtn").onclick = function () {
                    confirmDeleteDoctor(id);
                };

                var modal = new bootstrap.Modal(document.getElementById('doctorModal'));
                modal.show();
            });
    }

    function confirmDeleteDoctor(id) {
        if (confirm("Are you sure you want to delete this doctor?")) {
            var form = document.createElement("form");
            form.method = "post";
            form.action = '/Doctor/Delete';

            var input = document.createElement("input");
            input.type = "hidden";
            input.name = "id";
            input.value = id;

            form.appendChild(input);
            document.body.appendChild(form);
            form.submit();
        }
    }
</script>