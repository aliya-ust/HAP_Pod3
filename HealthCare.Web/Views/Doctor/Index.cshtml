@model HealthCare.Shared.PagedResult<HealthCare.Shared.DTOs.Doctor.DoctorDto>

@{
    ViewBag.Title = "Doctor Management";
}

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

<!-- ✅ MODAL -->
<div class="modal fade" id="doctorModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content p-3">

            <div class="d-flex justify-content-between">
                <h4>Doctor Profile</h4>
                <button class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <hr />

            <div id="doctorContent"></div>

            <div class="mt-3 text-end">
                <a id="editDoctorBtn" class="btn btn-warning">
                    <i class="fa fa-edit"></i> Edit
                </a>

                <button id="deleteDoctorBtn" class="btn btn-danger">
                    <i class="fa fa-trash"></i> Delete
                </button>
            </div>

        </div>
    </div>
</div>

<div class="container mt-3">

    <div class="d-flex justify-content-between mb-3">
        <h3>Doctor Management</h3>

        <a href="@Url.Action("Register", "Doctor")" class="btn btn-primary">
            + Add Doctor
        </a>
    </div>

    <!-- ✅ SEARCH -->
    <div class="row mb-3">

        <div class="col-md-6">
            <input type="text" id="searchTerm" class="form-control"
                   placeholder="Search by ID or Name" />
        </div>

        <div class="col-md-6">
            <select id="specialisation" class="form-control">
                <option value="">-- Select Specialisation --</option>
                <option>Cardiology</option>
                <option>Dermatology</option>
                <option>Neurology</option>
                <option>Orthopedics</option>
            </select>
        </div>

    </div>

    <button class="btn btn-dark mb-3" onclick="searchDoctors()">Search</button>

    <!-- ✅ TABLE -->
    <table class="table table-bordered">
        <thead class="table-dark">
            <tr>
                <th>ID</th>
                <th>Name</th>
                <th>Specialisation</th>
                <th>Actions</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var doc in Model.Items)
            {
                <tr>
                    <td>@doc.DoctorId</td>
                    <td>@doc.FullName</td>
                    <td>@doc.Specialisation</td>

                    <td>
                        <!-- ✅ PROFILE -->
                        <button class="btn btn-info btn-sm"
                                onclick="showDoctor(@doc.DoctorId)">
                            <i class="fa fa-eye"></i>
                        </button>

                        <!-- ✅ EDIT -->
                        <a class="btn btn-warning btn-sm"
                           href="@Url.Action("Edit", new { id = doc.DoctorId })">
                            <i class="fa fa-edit"></i>
                        </a>

                        <!-- ✅ DELETE -->
                        <button class="btn btn-danger btn-sm"
                                onclick="confirmDeleteDoctor(@doc.DoctorId)">
                            <i class="fa fa-trash"></i>
                        </button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<script>
    function searchDoctors() {
        var term = document.getElementById("searchTerm").value;
        var spec = document.getElementById("specialisation").value;

        window.location.href =
            '/Doctor/Index?searchTerm=' + term + '&specialisation=' + spec;
    }
</script>

<script>
    function showDoctor(id) {
        fetch('/Doctor/Profile/' + id)
            .then(res => res.text())
            .then(html => {

                document.getElementById("doctorContent").innerHTML = html;

                document.getElementById("editDoctorBtn").href = '/Doctor/Edit/' + id;

                document.getElementById("deleteDoctorBtn").onclick = function () {
                    confirmDeleteDoctor(id);
                };

                var modal = new bootstrap.Modal(document.getElementById('doctorModal'));
                modal.show();
            });
    }
</script>

<script>
    function confirmDeleteDoctor(id) {
        if (confirm("Are you sure you want to delete this doctor?")) {
            var form = document.createElement("form");
            form.method = "post";
            form.action = '/Doctor/Delete';

            var input = document.createElement("input");
            input.type = "hidden";
            input.name = "id";
            input.value = id;

            form.appendChild(input);
            document.body.appendChild(form);
            form.submit();
        }
    }
</script>