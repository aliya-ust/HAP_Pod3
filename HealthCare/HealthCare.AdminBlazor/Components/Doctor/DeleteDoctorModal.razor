@using Microsoft.AspNetCore.Components

@if (Visible)
{
    <div class="modal-overlay">

        <div class="modal-box">

            <button class="close-btn" @onclick="Cancel">×</button>

            <div class="icon-wrapper">
                <div class="icon">!</div>
            </div>

            <h3>Confirm Deletion</h3>

            <p class="message">
                Are you sure you want to delete this doctor?
                This action cannot be undone.
            </p>

            <div class="button-section">

                <button class="cancel-btn" @onclick="Cancel">
                    Cancel
                </button>

                <button class="delete-btn" @onclick="ConfirmDelete">
                    Delete
                </button>

            </div>

        </div>

    </div>
}

@code {

    [Parameter] public bool Visible { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }
    [Parameter] public EventCallback OnConfirm { get; set; }

    private async Task Cancel() => await OnCancel.InvokeAsync();
    private async Task ConfirmDelete() => await OnConfirm.InvokeAsync();
}

<style>

   
    .modal-overlay {
        position: fixed;
        inset: 0;
        background: rgba(15, 23, 42, 0.45);
        display: flex;
        justify-content: center;
        align-items: center;
        z-index: 9999;
    }

    .modal-box {
        width: 480px;
        max-width: 92%;
        background: white;
        border-radius: 22px;
        padding: 40px 28px 25px; 
        box-shadow: 0 30px 80px rgba(0, 0, 0, 0.35);
        text-align: center;
        position: relative;
        overflow: visible; 
    }

   
    .close-btn {
        position: absolute;
        top: 12px;
        right: 14px;
        background: transparent;
        border: none;
        font-size: 26px;
        cursor: pointer;
        color: #64748b;
        transition: 0.2s;
    }

        .close-btn:hover {
            color: #0f172a;
        }

    
    .icon-wrapper {
        display: flex;
        justify-content: center;
        margin-top: -60px;
        margin-bottom: 12px;
    }

    .icon {
        width: 75px;
        height: 75px;
        border-radius: 50%;
        background: #fee2e2;
        color: #dc2626;
        font-size: 34px;
        font-weight: bold;
        display: flex;
        align-items: center;
        justify-content: center;
        border: 5px solid white;
        box-shadow: 0 10px 25px rgba(220, 38, 38, 0.25);
    }

    h3 {
        margin: 10px 0;
        font-size: 22px;
        color: #0f172a;
        font-weight: 700;
    }

    .message {
        color: #475569;
        font-size: 15px;
        line-height: 1.6;
        margin-bottom: 25px;
        padding: 0 10px;
    }

    .button-section {
        display: flex;
        gap: 12px;
    }

        .button-section button {
            flex: 1;
            height: 44px;
            border-radius: 10px;
            font-weight: 600;
            cursor: pointer;
            border: none;
            transition: 0.2s;
        }

    .cancel-btn {
        background: #e2e8f0;
        color: #1e293b;
    }

    .delete-btn {
        background: #dc2626;
        color: white;
    }

    .cancel-btn:hover {
        background: #cbd5e1;
    }

    .delete-btn:hover {
        background: #b91c1c;
    }

</style>