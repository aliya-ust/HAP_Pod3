@using HealthCare.Shared.DTOs.Doctor
@using HealthCare.AdminBlazor.Services
@using HealthCare.Shared.Enums
@inject DoctorAdminService DoctorService

@if (!string.IsNullOrWhiteSpace(errorMessage))
{
    <div class="alert alert-danger">
        @errorMessage
    </div>
}

@if (Visible)
{
    <div class="modal-overlay">

        <div class="modal-box">

            <div class="modal-header">
                <h3>Update Doctor</h3>

                <button class="close-btn"
                        @onclick="Close">
                    ✖
                </button>
            </div>

            <EditForm Model="model"
                      OnValidSubmit="SaveDoctor">

                <DataAnnotationsValidator />
                @* <ValidationSummary /> *@

                <div class="form-group">
                    <label>Full Name</label>

                    <InputText class="form-control"
                               @bind-Value="model.FullName" />

                    <ValidationMessage For="@(() => model.FullName)" />
                </div>

                <div class="form-group">
                    <label>Specialisation</label>

                    <InputSelect class="form-control filter-dropdown"
                                 @bind-Value="model.Specialisation">
                       

                        @foreach (var item in Enum.GetValues<DoctorSpecialization>())
                        {
                            <option value="@item">@item</option>
                        }

                    </InputSelect>

                    <ValidationMessage For="@(() => model.Specialisation)" />
                </div>

                <div class="form-group">
                    <label>Years Of Experience</label>

                    <InputNumber class="form-control"
                                 @bind-Value="model.YearsOfExperience" />

                    <ValidationMessage For="@(() => model.YearsOfExperience)" />
                </div>

                <div class="button-section">
                    <button type="button"
                            class="cancel-btn"
                            @onclick="Close">
                        Cancel
                    </button>

                    <button type="submit"
                            class="save-btn">
                        Save Changes
                    </button>
                </div>

            </EditForm>

        </div>

    </div>
}

@code {

    [Parameter]
    public DoctorListDto? Doctor { get; set; }

    [Parameter]
    public bool Visible { get; set; }

    [Parameter]
    public EventCallback OnClose { get; set; }

    [Parameter]
    public EventCallback OnSaved { get; set; }

    private UpdateDoctorDto model = new();

    protected override void OnParametersSet()
    {
        if (Doctor != null)
        {
            model = new UpdateDoctorDto
            {
                FullName = Doctor.FullName,
                Specialisation =
        Enum.TryParse<DoctorSpecialization>(
            Doctor.Specialisation,
            true,
            out var specialization)
                ? specialization
                : DoctorSpecialization.GeneralMedicine,

                YearsOfExperience = Doctor.YearsOfExperience
            };
        }
    }

    private string errorMessage = "";

    private async Task SaveDoctor()
    {
        errorMessage = "";

        try
        {
            if (Doctor == null)
                return;

            await DoctorService.UpdateDoctor(Doctor.DoctorId, model);

            await OnSaved.InvokeAsync();   // ✅ notify parent (IMPORTANT)
            await OnClose.InvokeAsync();   // ✅ CLOSE MODAL
        }
        catch (Exception ex)
        {
            errorMessage = ex.ToString();
        }
    }

    private async Task Close()
    {
        await OnClose.InvokeAsync();
    }
}

