    padding: 10px 14px;
}

.btn-search {
    background: linear-gradient(135deg,#0f172a,#1e3a8a,#2563eb);
    color: white;
    border: none;
    border-radius: 12px;
    padding: 12px 20px;
    font-weight: 600;
    cursor: pointer;
}

.table-container {
    background: white;
    border-radius: 24px;
    overflow: hidden;
    box-shadow: 0 8px 25px rgba(0,0,0,.08);
}

.appointment-report-table {
    width: 100%;
    border-collapse: collapse;
}

.appointment-report-table thead {
    background: linear-gradient(90deg,#0f172a,#2563eb);
    color: white;
}

.appointment-report-table th,
.appointment-report-table td {
    padding: 22px;
    text-align: left;
