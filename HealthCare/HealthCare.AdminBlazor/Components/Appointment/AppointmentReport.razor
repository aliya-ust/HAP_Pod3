@page "/appointment-report"

@using HealthCare.AdminBlazor.Pages
@using HealthCare.Shared.DTOs.Appointment
@inject AppointmentAdminService AppointmentService

<PageTitle>Appointment Reports</PageTitle>

<div class="appointment-container">

    <!-- HEADER -->
    <div class="page-header">
        <div>
            <h1>Appointment Reports</h1>
            <p>View appointment statistics by date</p>
        </div>
    </div>

    <!-- FILTER SECTION -->
    <div class="filter-bar">

        <input type="date"
               class="form-control filter-input"
               @bind="startDate"
               max="@MaxDateString" />

        <input type="date"
               class="form-control filter-input"
               @bind="endDate"
               max="@MaxDateString" />

        <button type="button" class="btn-search" @onclick="ApplyFilter">
            Search
        </button>

    </div>


    <!-- TABLE -->
    <div class="table-container">

        <table class="appointment-report-table">

            <thead>
                <tr>
                    <th>Date</th>
                    <th>Pending</th>
                    <th>Confirmed</th>
                    <th>Cancelled</th>
                    <th>Completed</th>
                    <th>Revenue</th>
                </tr>
            </thead>

            <tbody>
                @if (reports.Any())
                {
                    int index = 0;

                    @foreach (var r in reports)
                    {
                        <tr class="@(index % 2 == 0 ? "row-light" : "row-white")">
                            <td>@r.Date.ToString("dd MMM yyyy")</td>
                            <td>@r.PendingCount</td>
                            <td>@r.ConfirmedCount</td>
                            <td>@r.CancelledCount</td>
                            <td>@r.CompletedCount</td>
                            <td>
                                @(r.CompletedCount > 0
                                    ? $"₹ {r.Revenue:N2}"
                                    : "-")
                            </td>

                        </tr>

                        index++;
                    }
                }
                else
                {
                    <tr>
                        <td colspan="5" class="no-data">
                            No reports available for selected dates
                        </td>
                    </tr>
                }

            </tbody>

        </table>

    </div>

    <!-- PAGINATION -->
    <div class="pagination-container">

        <button class="page-btn"
                @onclick="PreviousPage"
                disabled="@(currentPage == 1)">
            ← Previous
        </button>

        <span class="page-info">
            Page @currentPage of @pagedResult.TotalPages
        </span>

        <button class="page-btn"
                @onclick="NextPage"
                disabled="@(currentPage == pagedResult.TotalPages)">
            Next →
        </button>

    </div>
    </div>

@code {

    private List<AppointmentReportDto> reports = new();
   
    private static DateOnly MaxDate => DateOnly.FromDateTime(DateTime.Today);

    private string MaxDateString => MaxDate.ToString("yyyy-MM-dd");

    private DateTime startDate;
    private DateTime endDate;

    private PagedResult<AppointmentReportDto> pagedResult = new();

    private int currentPage = 1;
    private readonly int pageSize = 5;


    protected override async Task OnInitializedAsync()
    {
        SetDefaultDates();
        await LoadReports();
    }

    private void SetDefaultDates()
    {
        endDate = DateTime.Today;
        startDate = endDate.AddDays(-7);
    }


    private async Task LoadReports()
    {
        currentPage = 1; // ✅ reset on new load

        pagedResult = await AppointmentService.GetReports(
            DateOnly.FromDateTime(startDate),
            DateOnly.FromDateTime(endDate),
            currentPage,
            pageSize);

        reports = pagedResult.Items.ToList();
    }

    private async Task ApplyFilter()
    {
        if (startDate > endDate)
            return;

        currentPage = 1;

        pagedResult = await AppointmentService.GetReports(
            DateOnly.FromDateTime(startDate),
            DateOnly.FromDateTime(endDate),
            currentPage,
            pageSize);

        reports = pagedResult.Items.ToList();
    }


    private async Task NextPage()
    {
        if (currentPage < pagedResult.TotalPages)
        {
            currentPage++;

            pagedResult = await AppointmentService.GetReports(
                DateOnly.FromDateTime(startDate),
                DateOnly.FromDateTime(endDate),
                currentPage,
                pageSize);

            reports = pagedResult.Items.ToList();
        }
    }

    private async Task PreviousPage()
    {
        if (currentPage > 1)
        {
            currentPage--;

            pagedResult = await AppointmentService.GetReports(
                DateOnly.FromDateTime(startDate),
                DateOnly.FromDateTime(endDate),
                currentPage,
                pageSize);

            reports = pagedResult.Items.ToList();
        }
    }
}

<style>
   .appointment-container {
    padding: 35px;
    margin-left: 15px;
}

.page-header {
    margin-bottom: 20px;
}

.page-header h1 {
    font-size: 3rem;
    font-weight: 700;
    color: #0f172a;
    margin: 0;
}

.page-header p {
    margin-top: 8px;
    color: #64748b;
    font-size: 1.1rem;
}

.filter-bar {
    display: flex;
    align-items: center;
    gap: 16px;
    margin: 20px 0;
}

