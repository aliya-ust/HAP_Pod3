}

    .pagination-container {
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 20px;
        margin-top: 25px;
    }

    .page-btn {
        background: linear-gradient(135deg,#0f172a,#1e3a8a,#2563eb);
        color: white;
        border: none;
        border-radius: 10px;
        padding: 10px 18px;
        font-weight: 600;
        cursor: pointer;
    }

        .page-btn:disabled {
            background: #cbd5f5;
            color: #64748b;
            cursor: not-allowed;
        }

    .page-info {
        font-weight: 600;
        color: #0f172a;
    }

    
</style>