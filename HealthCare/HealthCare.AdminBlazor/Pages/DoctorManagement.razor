@page "/doctor-management"

@inject DoctorAdminService DoctorService

<PageTitle>Doctor Management</PageTitle>

<div class="doctor-container">

    @if (showSuccessMessage)
    {
        <div class="success-toast">
            ✔ @successMessage
        </div>
    }

    <!-- ✅ HEADER -->
    <div class="page-header">

        <div>
            <h1>Doctor Management</h1>
            <p>Manage doctors in the healthcare system</p>
        </div>

        <!-- ✅ ONLY BUTTONS HERE -->
        <div class="top-actions">
            <button class="btn-showall"
                    @onclick="LoadDoctors">
                Show All
            </button>

            <button class="btn-register"
                    @onclick="OpenRegisterModal">
                + Register
            </button>
        </div>

    </div>

    <!-- ✅ FILTER TOOLBAR BELOW HEADER -->
    <DoctorToolbar @ref="toolbarRef"
                   OnFilter="ApplyFilter" />

    <!-- ✅ TABLE -->
    <div class="table-wrapper">
        <DoctorTable Doctors="doctors"
                     IsSearchPerformed="isSearchPerformed"
                     OnEdit="OpenEditModal"
                     OnDelete="ConfirmDeleteDoctor"
                     OnToggleStatus="ToggleDoctorStatus" />
        <div class="pagination-container">

            <button class="page-btn"
                    @onclick="PreviousPage"
                    disabled="@(currentPage == 1)">
                ← Previous
            </button>

            <span class="page-info">
                Page @currentPage of @pagedResult.TotalPages
            </span>

            <button class="page-btn"
                    @onclick="NextPage"
                    disabled="@(currentPage == pagedResult.TotalPages)">
                Next →
            </button>

        </div>
        
    </div>

</div>

<!-- ✅ MODALS (UNCHANGED) -->
<UpdateDoctorModal Doctor="selectedDoctor"
                   Visible="showEditModal"
                   OnClose="CloseEditModal"
                   OnSaved="DoctorUpdated" />

<RegisterDoctorModal Visible="showRegisterModal"
                     OnClose="CloseRegisterModal"
                     OnSaved="LoadDoctors" />

<DeleteDoctorModal Visible="showDeleteModal"
                   OnCancel="CancelDelete"
                   OnConfirm="DeleteDoctor" />

@code {

    private List<DoctorListDto> doctors = new();
    private DoctorListDto? selectedDoctor;
    private DoctorToolbar? toolbarRef;


    private bool isSearchPerformed = false;

    private bool showEditModal;
    private bool showRegisterModal;

    private bool showDeleteModal;
    private int pendingDeleteId;

    private PagedResult<DoctorListDto> pagedResult = new();
    private int currentPage = 1;
    private int pageSize = 5;

    private string successMessage = "";
    private bool showSuccessMessage = false;

    protected override async Task OnInitializedAsync()
    {
        await LoadDoctors();
    }

    private async Task LoadDoctors()
    {
        currentPage = 1;   // ✅ reset

        var filter = new DoctorFilter
        {
            PageNumber = currentPage,
            PageSize = pageSize
        };

        pagedResult = await DoctorService.GetAllDoctors(filter);

        doctors = pagedResult.Items.ToList();

        toolbarRef?.ResetFilters();
    }

    private async Task NextPage()
    {
        if (currentPage < pagedResult.TotalPages)
        {
            currentPage++;

            var filter = new DoctorFilter
            {
                PageNumber = currentPage,
                PageSize = pageSize
            };

            pagedResult = await DoctorService.GetAllDoctors(filter);

            doctors = pagedResult.Items.ToList();
        }
    }


    private async Task PreviousPage()
    {
        if (currentPage > 1)
        {
            currentPage--;

            var filter = new DoctorFilter
            {
                PageNumber = currentPage,
                PageSize = pageSize
            };

            pagedResult = await DoctorService.GetAllDoctors(filter);

            doctors = pagedResult.Items.ToList();
        }
    }



    // ✅ NEW FILTER METHOD
    private async Task ApplyFilter(DoctorFilter filter)
    {
        currentPage = 1;   // ✅ VERY IMPORTANT

        filter.PageNumber = currentPage;
        filter.PageSize = pageSize;

        pagedResult = await DoctorService.FilterDoctors(filter);

        doctors = pagedResult.Items.ToList();

        isSearchPerformed = true;
    }

    private void OpenEditModal(DoctorListDto doctor)
    {
        selectedDoctor = doctor;
        showEditModal = true;
    }

    private void CloseEditModal()
    {
        showEditModal = false;
    }

    private void OpenRegisterModal()
    {
        showRegisterModal = true;
    }

    private void CloseRegisterModal()
    {
        showRegisterModal = false;
    }

    private void ConfirmDeleteDoctor(int id)
    {
        pendingDeleteId = id;
        showDeleteModal = true;
    }

    private void CancelDelete()
    {
        pendingDeleteId = 0;
        showDeleteModal = false;
    }

    private async Task DeleteDoctor()
    {
        await DoctorService.DeleteDoctor(pendingDeleteId);

        await LoadDoctors();

        showDeleteModal = false;
        pendingDeleteId = 0;

        await ShowSuccessMessage("Doctor deleted successfully.");
    }

    private async Task ShowSuccessMessage(string message)
    {
        successMessage = message;
        showSuccessMessage = true;

        StateHasChanged();

        await Task.Delay(5000);

        showSuccessMessage = false;
        successMessage = "";

        StateHasChanged();
    }

    private async Task ToggleDoctorStatus(DoctorListDto doctor)
    {
        await DoctorService.ToggleStatus(
            doctor.DoctorId,
            !doctor.IsActive);

        await LoadDoctors();
    }

    private async Task DoctorUpdated()
    {
        showEditModal = false;   

        await LoadDoctors();     

        await ShowSuccessMessage("Doctor updated successfully.");  // ✅ show toast
    }
}

<style>

    .doctor-container {
        padding: 35px;
        margin-left: 15px;
    }

    .page-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 20px;
        margin-bottom: 20px;
        flex-wrap: wrap;
    }

    .page-header h1 {
        font-size: 3rem;
        font-weight: 700;
        color: #0f172a;
        margin: 0;
    }

    .page-header p {
        margin-top: 8px;
        color: #64748b;
        font-size: 1.1rem;
    }

    /* ✅ TOP RIGHT BUTTONS */
    .top-actions {
        display: flex;
        gap: 20px;
    }

    .btn-showall {
        background: #0f172a;
        color: white;
        border: none;
        border-radius: 12px;   
        padding: 12px 18px;
        font-weight: 600;
    }
    
    .btn-register {
    background: linear-gradient(135deg,#0f172a,#1e3a8a,#2563eb);
    color: white;
    border: none;
    border-radius: 12px;
    padding: 12px 18px;
    font-weight: 600;
}

    .success-toast {
        position: fixed;
        top: 20px;
        left: 50%;
        transform: translateX(-50%);
        background: #dcfce7;
        color: #166534;
        border: 1px solid #86efac;
        padding: 16px 28px;
        border-radius: 12px;
        font-weight: 600;
        box-shadow: 0 8px 20px rgba(0,0,0,0.15);
        z-index: 9999;
        min-width: 350px;
        text-align: center;
        animation: slideDown 0.3s ease; /* ✅ smooth entry */
    }

    .pagination-container {
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 20px;
        margin-top: 25px;
    }

    .page-btn {
        background: linear-gradient(135deg,#0f172a,#1e3a8a,#2563eb);
        color: white;
        border: none;
        border-radius: 10px;
        padding: 10px 18px;
        font-weight: 600;
        cursor: pointer;
    }

        .page-btn:disabled {
            background: #cbd5f5;
            color: #64748b;
            cursor: not-allowed;
        }

    .page-info {
        font-weight: 600;
        color: #0f172a;
    }
</style>
