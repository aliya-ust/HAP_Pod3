@page "/dashboard"

@using HealthCare.Shared.DTOs
@inject DashboardService DashboardService

<PageTitle>Dashboard</PageTitle>

<div class="dashboard-container">

    <!-- HEADER -->
    <div class="dashboard-header">
        <h1>Admin Dashboard</h1>
        <p>Overview of HealthCare Portal System</p>
    </div>

    <!-- CARDS -->
    <div class="stats-grid">

        <div class="stat-card card-blue">
    <div class="card-header">
        <h5>Total Doctors</h5>
        <i class="bi bi-person-badge card-icon"></i>
    </div>
    <h2>@doctorSummary.TotalDoctors</h2>
    </div>

        <div class="stat-card card-green">
    <div class="card-header">
        <h5>Active Doctors</h5>
        <i class="bi bi-person-check card-icon"></i>
    </div>
    <h2>@doctorSummary.ActiveDoctors</h2>
    </div>

       <div class="stat-card card-purple">
    <div class="card-header">
        <h5>Total Patients</h5>
        <i class="bi bi-people card-icon"></i>
    </div>
    <h2>@totalPatients</h2>
    </div>

       <div class="stat-card card-orange">
    <div class="card-header">
        <h5>Total Appointments</h5>
        <i class="bi bi-calendar-event card-icon"></i>
    </div>
    <h2>
        @(appointmentSummary.PendingCount +
          appointmentSummary.ConfirmedCount +
          appointmentSummary.CancelledCount +
          appointmentSummary.CompletedCount)
    </h2>
    </div>

        <div class="stat-card card-yellow">
    <div class="card-header">
        <h5>Pending Appointments</h5>
        <i class="bi bi-hourglass-split card-icon"></i>
    </div>
    <h2>@appointmentSummary.PendingCount</h2>
    </div>

        <div class="stat-card card-blue">
    <div class="card-header">
        <h5>Confirmed Appointments</h5>
        <i class="bi bi-check-circle card-icon"></i>
    </div>
    <h2>@appointmentSummary.ConfirmedCount</h2>
    </div>

        <div class="stat-card card-red">
    <div class="card-header">
        <h5>Cancelled Appointments</h5>
        <i class="bi bi-x-circle card-icon"></i>
    </div>
    <h2>@appointmentSummary.CancelledCount</h2>
    </div>

        <div class="stat-card card-green">
    <div class="card-header">
        <h5>Completed Appointments</h5>
        <i class="bi bi-check2-circle card-icon"></i>
    </div>
    <h2>@appointmentSummary.CompletedCount</h2>
    </div>

        <div class="stat-card card-revenue">
    <div class="card-header">
        <h5>Total Revenue</h5>
        <i class="bi bi-cash-stack card-icon"></i>
    </div>
    <h2>₹ @appointmentSummary.TotalRevenue.ToString("N2")</h2>
    </div>

    </div>

</div>

@code {
    private DoctorSummaryDto doctorSummary = new();
    private AppointmentSummaryDto appointmentSummary = new();
    private int totalPatients;

    protected override async Task OnInitializedAsync()
    {
        doctorSummary = await DashboardService.GetDoctorSummary();
        appointmentSummary = await DashboardService.GetAppointmentSummary();
        totalPatients = await DashboardService.GetRecentPatients();
    }
}

<style>

    /* ===== BACKGROUND ===== */
.dashboard-container {
    padding: 40px;
    min-height: 100vh;

    background: linear-gradient(135deg, #f8fafc, #eef4ff);
    position: relative;
    overflow: hidden;
}

/* ✅ Soft shapes */
.dashboard-container::before {
    content: "";
    position: absolute;
    width: 300px;
    height: 300px;
    background: rgba(37, 99, 235, 0.1);
    border-radius: 50%;
    top: -80px;
    right: -100px;
}

.dashboard-container::after {
    content: "";
    position: absolute;
    width: 250px;
    height: 250px;
    background: rgba(37, 99, 235, 0.08);
    border-radius: 50%;
    bottom: -80px;
    left: -100px;
}

/* ===== HEADER ===== */
.dashboard-header {
    margin-bottom: 35px;
}

.dashboard-header h1 {
    font-size: 42px;
    font-weight: 700;
    color: #0f172a;
}

.dashboard-header p {
    color: #64748b;
    font-size: 18px;
}

/* ===== GRID ===== */
.stats-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 22px;
}

/* ===== CARDS ===== */
.stat-card {
    background: white;
    border-radius: 18px;
    padding: 26px;
    box-shadow: 0 12px 30px rgba(0,0,0,0.08);
    border-left: 5px solid #2563eb;
    transition: all 0.3s ease;
}

.stat-card:hover {
    transform: translateY(-6px);
    box-shadow: 0 20px 35px rgba(0,0,0,0.12);
}

.stat-card h5 {
    color: #64748b;
    font-size: 16px;
    margin-bottom: 10px;
}

.stat-card h2 {
    font-size: 34px;
    font-weight: bold;
    color: #1e3a8a;
}

/* ===== COLOR VARIANTS ===== */
.card-blue   { border-left-color: #2563eb; }
.card-green  { border-left-color: #16a34a; }
.card-yellow { border-left-color: #eab308; }
.card-red    { border-left-color: #dc2626; }
.card-purple { border-left-color: #7c3aed; }
.card-orange { border-left-color: #ea580c; }
.card-revenue { border-left-color: #059669; }

/* ===== RESPONSIVE ===== */
@@media (max-width: 768px) {
    .dashboard-container {
        padding: 20px;
    }

    .dashboard-header h1 {
        font-size: 32px;
    }
}

.card-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
}

.card-icon {
    font-size: 22px;
    opacity: 0.7;
}

/* optional: colored icons */
.card-blue .card-icon   { color: #2563eb; }
.card-green .card-icon  { color: #16a34a; }
.card-yellow .card-icon { color: #eab308; }
.card-red .card-icon    { color: #dc2626; }
.card-purple .card-icon { color: #7c3aed; }
.card-orange .card-icon { color: #ea580c; }
.card-revenue .card-icon { color: #059669; }

</style>