    display: flex;
    gap: 12px;
}

.btn-showall {
    background: #0f172a;
    color: white;
    border: none;
    border-radius: 12px;
    padding: 12px 18px;
    font-weight: 600;
    cursor: pointer;
}

.btn-register {
    background: linear-gradient(135deg,#0f172a,#1e3a8a,#2563eb);
    color: white;
    border: none;
    border-radius: 12px;
    padding: 12px 18px;
    font-weight: 600;
    cursor: pointer;
}

/* TABLE WRAPPER */
.table-wrapper {
    margin-top: 20px;
}

/* SUCCESS TOAST */
.success-toast {
    position: fixed;
    top: 20px;
    left: 50%;
    transform: translateX(-50%);
    background: #dcfce7;
    color: #166534;
    padding: 14px 30px;
    border-radius: 10px;
    font-weight: 600;
}

    
    .page-content-wrapper {
        padding: 30px 40px; 
        display: flex;
        justify-content: center;
    }

    .doctor-container {
        width: 100%; 
    }

    .pagination-container {
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 20px;
        margin-top: 25px;
    }

    .page-btn {
        background: linear-gradient(135deg,#0f172a,#1e3a8a,#2563eb);
        color: white;
        border: none;
        border-radius: 10px;
        padding: 10px 18px;
        font-weight: 600;
        cursor: pointer;
    }

        .page-btn:disabled {
            background: #cbd5f5;
            color: #64748b;
            cursor: not-allowed;
        }

    .page-info {
        font-weight: 600;
        color: #0f172a;
    }

    
</style>
