    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 20px;
    margin-bottom: 20px;
    flex-wrap: wrap;
}

.page-header h1 {
    font-size: 3rem;
    font-weight: 700;
    color: #0f172a;
    margin: 0;
}

