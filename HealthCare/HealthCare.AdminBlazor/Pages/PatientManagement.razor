@page "/patient-management"

@using HealthCare.AdminBlazor.Components.Patient
@inject PatientAdminService PatientService

<PageTitle>Patient Management</PageTitle>

<div class="patient-container">

    @if (showSuccessMessage)
    {
        <div class="success-toast">
            ✔ @successMessage
        </div>
    }

    <div class="page-header">

        <div>
            <h1>Patient Management</h1>
            <p>Manage patients in the healthcare system</p>
        </div>

        <div class="top-actions">

            <button class="btn-showall"
                    @onclick="LoadPatients">
                Show All
            </button>

        </div>

    </div>

    <PatientToolbar @ref="toolbarRef"
                      OnFilter="ApplyFilter" />

    <div class="table-wrapper">

        <PatientTable Patients="patients"
                      IsSearchPerformed="isSearchPerformed"
                      OnEdit="OpenEditModal"
                      OnDelete="ConfirmDeletePatient"
                      OnUpdateStatus="UpdatePatientStatus" />

        <div class="pagination-container">

            <button class="page-btn"
                    @onclick="PreviousPage"
                    disabled="@(currentPage == 1)">
                ← Previous
            </button>

            <span class="page-info">
                Page @currentPage of @pagedResult.TotalPages
            </span>

            <button class="page-btn"
                    @onclick="NextPage"
                    disabled="@(currentPage == pagedResult.TotalPages)">
                Next →
            </button>

        </div>

    </div>

</div>

<UpdatePatientModal Patient="selectedPatient"
                    Visible="showEditModal"
                    OnClose="CloseEditModal"
                    OnSaved="PatientUpdated" />

<RegisterPatientModal Visible="showRegisterModal"
                        OnClose="CloseRegisterModal"
                        OnSaved="LoadPatients" />

<DeletePatientModal Visible="showDeleteModal"
                    OnCancel="CancelDelete"
                    OnConfirm="DeletePatient" />

@code {

    private List<PatientListDto> patients = new();

    private PatientListDto? selectedPatient;

    private PatientToolbar? toolbarRef;

    private bool isSearchPerformed = false;

    private PagedResult<PatientListDto> pagedResult = new();

    private int currentPage = 1;
    private int pageSize = 5;


    private bool showEditModal;
    private bool showRegisterModal;
    private bool showDeleteModal;

    private int pendingDeleteId;

    private string successMessage = "";
    private bool showSuccessMessage = false;

    protected override async Task OnInitializedAsync()
    {
        await LoadPatients();
    }

    private async Task LoadPatients()
    {
        currentPage = 1; // Reset to first page
        isSearchPerformed = false;

        var filter = new PatientFilter
        {
            PageNumber = currentPage,
            PageSize = pageSize
        };

        pagedResult = await PatientService.GetAllPatients(filter);

        patients = pagedResult.Items.ToList();

        toolbarRef?.ResetFilters();
    }

    private async Task ApplyFilter(PatientFilter filter)
    {
        currentPage = 1; // Very important

        isSearchPerformed = true;

        filter.PageNumber = currentPage;
        filter.PageSize = pageSize;

        pagedResult = await PatientService.FilterPatients(filter);

        patients = pagedResult.Items.ToList();
    }

    private async Task NextPage()
    {
        if (currentPage < pagedResult.TotalPages)
        {
            currentPage++;

            var filter = new PatientFilter
            {
                PageNumber = currentPage,
                PageSize = pageSize
            };

            pagedResult = await PatientService.GetAllPatients(filter);

            patients = pagedResult.Items.ToList();
        }
    }

    private async Task PreviousPage()
    {
        if (currentPage > 1)
        {
            currentPage--;

            var filter = new PatientFilter
            {
                PageNumber = currentPage,
                PageSize = pageSize
            };

            pagedResult = await PatientService.GetAllPatients(filter);

            patients = pagedResult.Items.ToList();
        }
    }

    private void OpenEditModal(PatientListDto patient)
    {
        selectedPatient = patient;
        showEditModal = true;
    }

    private void CloseEditModal()
    {
        showEditModal = false;
    }

    private void OpenRegisterModal()
    {
        showRegisterModal = true;
    }

    private void CloseRegisterModal()
    {
        showRegisterModal = false;
    }

    private void ConfirmDeletePatient(int id)
    {
        pendingDeleteId = id;
        showDeleteModal = true;
    }

    private void CancelDelete()
    {
        showDeleteModal = false;
        pendingDeleteId = 0;
    }

    private async Task DeletePatient()
    {
        await PatientService.DeletePatient(pendingDeleteId);

        await LoadPatients();

        showDeleteModal = false;

        await ShowSuccessMessage("Patient deleted successfully.");
    }

    private async Task UpdatePatientStatus((PatientListDto patient, bool status) data)
    {
        var (patient, status) = data;

        await PatientService.ToggleStatus(patient.PatientId, status);

        await LoadPatients();
    }


    private async Task PatientUpdated()
    {
        showEditModal = false;

        await LoadPatients();

        await ShowSuccessMessage("Patient updated successfully.");
    }

    private async Task ShowSuccessMessage(string message)
    {
        successMessage = message;

        showSuccessMessage = true;

        StateHasChanged();

        await Task.Delay(5000);

        showSuccessMessage = false;

        StateHasChanged();
    }

}

<style>
.patient-container {
    padding: 35px;
    margin-left: 15px;
}

