@page "/patient"

@using HealthCare.Api.DTOs.Patient
@using HealthCare.Admin.Services

@inject PatientService PatientService
@inject NavigationManager NavigationManager

<div class="page-header">
    <div>
        <h3 class="page-title">Patient Management</h3>
        <p class="page-subtitle">Search, view, update status and delete patients</p>
    </div>
</div>

<div class="search-card">
    <div class="search-grid">

        <div class="form-group">
            <label>Patient Name</label>
            <input class="form-control small-input"
                   placeholder="Search by patient name"
                   @bind="search"
                   @bind:event="oninput" />
        </div>

        <div class="form-group">
            <label>Insurance Status</label>
            <select class="form-select small-input" @bind="hasInsuranceFilter">
                <option value="">All</option>
                <option value="true">Has Insurance</option>
                <option value="false">No Insurance</option>
            </select>
        </div>

        <div class="search-actions align-right">
            <button class="btn btn-success" @onclick="SearchPatients">
                Search
            </button>

            <button class="btn btn-outline-secondary" @onclick="ClearSearch">
                Clear
            </button>
        </div>

    </div>
</div>

<hr />

@if (isLoading)
{
    <div class="loading-box">
        <p>Loading patients...</p>
    </div>
}
else if (!string.IsNullOrWhiteSpace(errorMessage))
{
    <div class="alert alert-danger">@errorMessage</div>
}
else
{
    <div class="table-wrapper">
        <table class="table patient-table">
            <thead>
                <tr>
                    <th>Id</th>
                    <th>Name</th>
                    <th>Phone</th>
                    <th>Gender</th>
                    <th>Insurance</th>
                    <th>Status</th>
                    <th class="actions-header">Actions</th>
                </tr>
            </thead>

            <tbody>
                @if (patients.Count == 0)
                {
                    <tr>
                        <td colspan="7" class="empty-row">No patients found</td>
                    </tr>
                }
                else
                {
                    @foreach (var patient in patients)
                    {
                        <tr>
                            <td>@patient.PatientId</td>
                            <td>@patient.FullName</td>
                            <td>@patient.PhoneNumber</td>
                            <td>@patient.Gender</td>

                            <td>
                                @(patient.HasInsurance == true ? "Yes" : "No")
                            </td>

                            <td>
                                @if (patient.IsActive)
                                {
                                    <span class="status-badge active">Active</span>
                                }
                                else
                                {
                                    <span class="status-badge inactive">Inactive</span>
                                }
                            </td>

                            <td class="actions-cell">

                                <!-- Status Toggle Dialog Button -->
                                <button type="button"
                                        class="icon-button status-btn"
                                        title="Change Patient Status"
                                        @onclick="() => OpenStatusDialog(patient)">
                                    @if (patient.IsActive)
                                    {
                                        <i class="bi bi-toggle-on"></i>
                                    }
                                    else
                                    {
                                        <i class="bi bi-toggle-off"></i>
                                    }
                                </button>

                                <!-- Delete Patient -->
                                <button type="button"
                                        class="icon-button delete-btn"
                                        title="Delete Patient"
                                        @onclick="() => OpenDeleteDialog(patient)">
                                    <i class="bi bi-trash"></i>
                                </button>

                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    <!-- STATUS UPDATE DIALOG -->
    @if (showStatusDialog)
    {
        <div class="modal-backdrop-custom">
            <div class="dialog-box">

                <div class="dialog-header">
                    <h5>Update Patient Status</h5>

                    <button type="button"
                            class="close-button"
                            @onclick="CloseStatusDialog">
                        ✕
                    </button>
                </div>

                <div class="dialog-body">
                    <p>
                        Update status for
                        <strong>@selectedPatientName</strong>
                    </p>

                    <div class="form-group">
                        <label>Status</label>
                        <select class="form-select" @bind="selectedStatusValue">
                            <option value="true">Active</option>
                            <option value="false">Inactive</option>
                        </select>
                    </div>
                </div>

                <div class="dialog-footer">
                    <button type="button"
                            class="btn btn-outline-secondary"
                            @onclick="CloseStatusDialog">
                        Cancel
                    </button>

                    <button type="button"
                            class="btn btn-primary"
                            @onclick="UpdateStatus">
                        Save
                    </button>
                </div>

            </div>
        </div>
    }

    <!-- DELETE POPUP -->
    @if (showDeleteDialog)
    {
        <div class="modal-backdrop-custom">
            <div class="dialog-box">

                <div class="dialog-header">
                    <h5>Confirm Delete</h5>

                    <button type="button"
                            class="close-button"
                            @onclick="CloseDeleteDialog">
                        ✕
                    </button>
                </div>

                <div class="dialog-body">
                    <p>
                        Are you sure you want to delete patient
                        <strong>@selectedPatientName</strong>?
                    </p>

                    <p style="color:red;">
                        This action cannot be undone.
                    </p>
                </div>

                <div class="dialog-footer">
                    <button type="button"
                            class="btn btn-outline-secondary"
                            @onclick="CloseDeleteDialog">
                        Cancel
                    </button>

                    <button type="button"
                            class="btn btn-danger"
                            @onclick="ConfirmDelete">
                        Delete
                    </button>
                </div>

            </div>
        </div>
    }

    <div class="pagination-container">

        <button class="page-btn"
                @onclick="PreviousPage"
                disabled="@(pageNumber == 1)">
            ⟵
        </button>

        <span class="page-info">
            Page @pageNumber of @totalPages
        </span>

        <button class="page-btn"
                @onclick="NextPage"
                disabled="@disableNextButton">
            ⟶
        </button>

    </div>
}

@code {

    private List<PatientListDto> patients = new();

    private string search = "";
    private string hasInsuranceFilter = "";

    private int pageNumber = 1;
    private int pageSize = 5;
    private int totalPages = 1;

    private bool isLoading = false;
    private bool disableNextButton = false;
    private string errorMessage = "";

    private bool showDeleteDialog = false;
    private bool showStatusDialog = false;

    private int selectedPatientId;
    private string? selectedPatientName;
    private string selectedStatusValue = "true";

    protected override async Task OnInitializedAsync()
    {
        await LoadPatients();
    }

    private async Task LoadPatients()
    {
        try
        {
            isLoading = true;
            errorMessage = "";

            bool? insurance = null;

            if (!string.IsNullOrWhiteSpace(hasInsuranceFilter))
                insurance = bool.Parse(hasInsuranceFilter);

            var filter = new PatientFilter
            {
                Search = search,
                HasInsurance = insurance,
                PageNumber = pageNumber,
                PageSize = pageSize
            };

            var result = await PatientService.GetPatientsAsync(filter);

            patients = result.Items.ToList();

            totalPages = result.TotalPages == 0 ? 1 : result.TotalPages;

            disableNextButton = pageNumber >= totalPages;
        }
        catch (Exception ex)
        {
            if (ex.Message.Contains("Unauthorized"))
                NavigationManager.NavigateTo("/", true);
            else
                errorMessage = ex.Message;
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task SearchPatients()
    {
        pageNumber = 1;
        await LoadPatients();
    }

    private async Task ClearSearch()
    {
        search = "";
        hasInsuranceFilter = "";
        pageNumber = 1;

        await LoadPatients();
    }

    private async Task PreviousPage()
    {
        if (pageNumber > 1)
        {
            pageNumber--;
            await LoadPatients();
        }
    }

    private async Task NextPage()
    {
        if (!disableNextButton)
        {
            pageNumber++;
            await LoadPatients();
        }
    }

    private void OpenStatusDialog(PatientListDto patient)
    {
        selectedPatientId = patient.PatientId;
        selectedPatientName = patient.FullName;
        selectedStatusValue = patient.IsActive ? "true" : "false";
        showStatusDialog = true;
    }

    private void CloseStatusDialog()
    {
        showStatusDialog = false;
    }

    private async Task UpdateStatus()
    {
        bool newStatus = bool.Parse(selectedStatusValue);

        bool result = await PatientService.UpdatePatientStatusAsync(
            selectedPatientId,
            newStatus);

        if (result)
        {
            showStatusDialog = false;
            await LoadPatients();
        }
        else
        {
            errorMessage = "Failed to update patient status.";
        }
    }

    private void OpenDeleteDialog(PatientListDto patient)
    {
        selectedPatientId = patient.PatientId;
        selectedPatientName = patient.FullName;
        showDeleteDialog = true;
    }

    private void CloseDeleteDialog()
    {
        showDeleteDialog = false;
    }

    private async Task ConfirmDelete()
    {
        bool result = await PatientService.DeletePatientAsync(selectedPatientId);

        if (result)
        {
            showDeleteDialog = false;
            await LoadPatients();
        }
        else
        {
            errorMessage = "Failed to delete patient.";
        }
    }
}