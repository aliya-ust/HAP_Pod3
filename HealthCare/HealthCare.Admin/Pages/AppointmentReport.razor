@page "/appointmentreport"
@inject AppointmentService AppointmentService

<PageTitle>Appointment Report</PageTitle>

<div class="appointment-report-page">

    <div class="report-card">

        <div class="report-header">
            <h2>Appointment Summary</h2>
        </div>

        <div class="report-body">

            <div class="filter-section">

                <div class="filter-group">
                    <label>Start Date</label>
                    <InputDate @bind-Value="startDate"
                               class="form-control date-input"
                               max="@maxDate" />
                </div>

                <div class="filter-group">
                    <label>End Date</label>
                    <InputDate @bind-Value="endDate"
                               class="form-control date-input"
                               max="@maxDate" />
                </div>

                <div class="filter-button-wrapper">
                    <button class="search-btn" @onclick="SearchData">
                        Search
                    </button>
                </div>

            </div>

            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <div class="alert alert-danger mt-3">
                    @errorMessage
                </div>
            }

            <div class="table-wrapper">
                <table class="report-table">
                    <thead>
                        <tr>
                            <th>Date</th>
                            <th>Pending</th>
                            <th>Confirmed</th>
                            <th>Cancelled</th>
                            <th>Completed</th>
                            <th>Revenue</th>
                        </tr>
                    </thead>

                    <tbody>
                        @if (reports != null && reports.Any())
                        {
                            @foreach (var item in reports)
                            {
                                <tr>
                                    <td>@item.Date.ToString("dd-MMM-yyyy")</td>
                                    <td>@item.PendingCount</td>
                                    <td>@item.ConfirmedCount</td>
                                    <td>@item.CancelledCount</td>
                                    <td>@item.CompletedCount</td>
                                    <td>₹ @item.Revenue.ToString("0.00")</td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="6" class="no-data">
                                    No data found
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

        </div>

    </div>

</div>


@code {
    private DateTime startDate;
    private DateTime endDate;
    private string maxDate = DateTime.Today.ToString("yyyy-MM-dd");

    private List<AppointmentReportDto> reports = new();
    private string errorMessage = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        endDate = DateTime.Today;
        startDate = endDate.AddDays(-6);

        await LoadData();
    }

    private async Task LoadData()
    {
        errorMessage = string.Empty;

        try
        {
            reports = await AppointmentService.GetAppointmentReport(startDate, endDate);
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
    }

    private async Task SearchData()
    {
        errorMessage = string.Empty;

        if (startDate > DateTime.Today || endDate > DateTime.Today)
        {
            errorMessage = "Future dates are not allowed.";
            return;
        }

        if (startDate > endDate)
        {
            errorMessage = "Start date cannot be greater than end date.";
            return;
        }

        if ((endDate - startDate).TotalDays > 6)
        {
            errorMessage = "You can select a maximum of 7 days only.";
            return;
        }

        await LoadData();
    }
}