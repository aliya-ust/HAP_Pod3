@page "/Home"
@layout MainLayout

<div class="dashboard-container">

    <!-- Header -->
    <div class="dashboard-header">
        <h1>Admin Dashboard</h1>
        <p>Overview of HealthCare Portal System</p>
    </div>

    <!-- Stats Grid -->
    <div class="stats-grid">

        <div class="stat-card">
            <h2>40</h2>
            <p>Total Doctors</p>
        </div>

        <div class="stat-card">
            <h2>38</h2>
            <p>Active Doctors</p>
        </div>

        <div class="stat-card">
            <h2>250</h2>
            <p>Total Patients</p>
        </div>

        <div class="stat-card">
            <h2>120</h2>
            <p>Total Appointments</p>
        </div>

        <div class="stat-card">
            <h2>15</h2>
            <p>Pending Appointments</p>
        </div>

        <div class="stat-card">
            <h2>95</h2>
            <p>Confirmed Appointments</p>
        </div>

        <div class="stat-card">
            <h2>10</h2>
            <p>Cancelled Appointments</p> 
        </div>

        <div class="stat-card">
            <h2>180</h2>
            <p>Completed Appointments</p>
        </div>

    </div>

</div>
<style>
    .dashboard-container {
        padding: 25px;
        background: #f5f3ff;
        min-height: 100vh;
    }

    /* Header */
    .dashboard-header {
        margin-bottom: 25px;
    }

        .dashboard-header h1 {
            margin: 0;
            font-size: 32px;
            color: #5b21b6;
        }

        .dashboard-header p {
            margin: 5px 0 0;
            color: #6b7280;
        }

    /* Grid layout */
    .stats-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
        gap: 20px;
    }

    /* Card design */
    .stat-card {
        background: white;
        border-radius: 16px;
        padding: 20px;
        box-shadow: 0 6px 18px rgba(0,0,0,0.08);
        transition: 0.3s ease;
        text-align: center;
    }

        .stat-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 25px rgba(0,0,0,0.12);
        }

        /* Number style */
        .stat-card h2 {
            margin: 0;
            font-size: 32px;
            color: #7c3aed;
            font-weight: bold;
        }

        /* Label */
        .stat-card p {
            margin-top: 8px;
            color: #6b7280;
            font-weight: 500;
        } 
</style>