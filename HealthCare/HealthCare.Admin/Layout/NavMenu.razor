@inject NavigationManager Navigation
@inject IJSRuntime JS

<div class="hc-sidebar">

    <div class="hc-sidebar-header">
        <h2>HealthCare</h2>
        <p>Admin Portal</p>
    </div>

    <nav class="hc-nav-menu">

        <NavLink class="hc-nav-item" href="/home" Match="NavLinkMatch.All">
            <span class="bi bi-speedometer2"></span>
            <span>Dashboard</span>
        </NavLink>

        <NavLink class="hc-nav-item" href="/patient" Match="NavLinkMatch.Prefix">
            <i class="bi bi-people-fill"></i>
            <span>Patient Management</span>
        </NavLink>

        <NavLink class="hc-nav-item" href="/doctor" Match="NavLinkMatch.Prefix">
            <span class="bi bi-person-badge-fill"></span>
            <span>Doctor Management</span>
        </NavLink>

        <NavLink class="hc-nav-item" href="/appointmentreport" Match="NavLinkMatch.Prefix">
            <span class="bi bi-calendar-check-fill"></span>
            <span>Appointment Management</span>
        </NavLink> 

    </nav>

    <!-- ✅ Logout Button -->
    <div class="logout-section">
        <button class="logout-btn" @onclick="Logout">
            <span class="bi bi-box-arrow-right"></span>
            <span>Logout</span>
        </button>
    </div>

</div>

@code {
    private async Task Logout()
    {
        await JS.InvokeVoidAsync("localStorage.removeItem", "accesstoken");
        await JS.InvokeVoidAsync("localStorage.removeItem", "role");

        Navigation.NavigateTo("/", true);
    }
} 