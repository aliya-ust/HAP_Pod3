  "components": {
    "schemas": {
      "CreateAppointmentDto": {
        "required": [
          "doctorId",
          "patientId",
          "scheduledDate",
          "timeSlot"
        ],
        "type": "object",
        "properties": {
          "patientId": {
            "type": "integer",
            "format": "int32"
          },
          "doctorId": {
            "type": "integer",
            "format": "int32"
          },
          "scheduledDate": {
            "type": "string",
            "format": "date"
          },
          "timeSlot": {
            "maxLength": 20,
            "minLength": 1,
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "CreateDoctorDto": {
        "required": [
          "consultationFee",
          "email",
          "fullName",
          "password",
          "specialisation",
          "yearsOfExperience"
        ],
        "type": "object",
        "properties": {
          "fullName": {
            "maxLength": 100,
            "minLength": 1,
            "pattern": "^[A-Za-z\\s]+$",
            "type": "string"
          },
          "specialisation": {
            "maxLength": 50,
            "minLength": 1,
            "type": "string"
          },
          "email": {
            "maxLength": 100,
            "minLength": 1,
            "type": "string",
            "format": "email"
          },
          "password": {
            "minLength": 1,
            "type": "string"
          },
          "yearsOfExperience": {
            "maximum": 60,
            "minimum": 0,
            "type": "integer",
            "format": "int32"
          },
          "consultationFee": {
            "maximum": 5000,
            "minimum": 0.01,
            "type": "number",
            "format": "double"
          }
        },
        "additionalProperties": false
      },
      "CreatePatientDto": {
        "required": [
          "dateOfBirth",
          "email",
          "fullName",
          "gender",
          "password",
          "phoneNumber"
        ],
        "type": "object",
        "properties": {
          "fullName": {
            "maxLength": 100,
            "minLength": 1,
            "pattern": "^[A-Za-z\\s]+$",
            "type": "string"
          },
          "dateOfBirth": {
            "type": "string",
            "format": "date"
          },
          "gender": {
            "maxLength": 10,
            "minLength": 1,
            "pattern": "^(Male|Female|Other)$",
            "type": "string"
          },
          "phoneNumber": {
            "maxLength": 20,
            "minLength": 1,
            "pattern": "^[6-9]\\d{9}$",
            "type": "string"
          },
          "email": {
            "maxLength": 100,
            "minLength": 1,
            "type": "string",
            "format": "email"
          },
          "password": {
            "minLength": 1,
            "type": "string"
          },
          "insuranceId": {
            "maxLength": 50,
            "pattern": "^[A-Za-z0-9]+$",
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "LoginDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "nullable": true
          },
          "password": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "UpdateAppointmentDto": {
        "required": [
          "status"
        ],
        "type": "object",
        "properties": {
          "status": {
            "maxLength": 20,
            "minLength": 1,
            "type": "string"
          },
          "cancellationReason": {
            "maxLength": 500,
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "UpdateDoctorDto": {
        "required": [
          "fullName",
          "specialisation"
        ],
        "type": "object",
        "properties": {
          "fullName": {
            "maxLength": 100,
            "minLength": 1,
            "pattern": "^[A-Za-z\\s]+$",
            "type": "string"
          },
          "specialisation": {
            "maxLength": 50,
            "minLength": 1,
            "type": "string"
          },
          "yearsOfExperience": {
            "maximum": 60,
            "minimum": 0,
            "type": "integer",
            "format": "int32"
          },
          "consultationFee": {
            "maximum": 5000,
            "minimum": 0.01,
            "type": "number",
            "format": "double"
          }
        },
        "additionalProperties": false
      },
      "UpdatePatientDto": {
        "required": [
          "email",
          "fullName",
          "gender",
          "phoneNumber"
        ],
        "type": "object",
        "properties": {
          "fullName": {
            "maxLength": 100,
            "minLength": 1,
            "pattern": "^[A-Za-z\\s]+$",
            "type": "string"
          },
          "phoneNumber": {
            "maxLength": 20,
            "minLength": 1,
            "pattern": "^[6-9]\\d{9}$",
            "type": "string"
          },
          "email": {
            "maxLength": 100,
            "minLength": 1,
            "type": "string",
            "format": "email"
          },
          "gender": {
            "maxLength": 10,
            "minLength": 1,
            "pattern": "^(Male|Female|Other)$",
            "type": "string"
          },
          "insuranceId": {
            "maxLength": 50,
            "pattern": "^[A-Za-z0-9]+$",
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "WeatherForecast": {
        "type": "object",
        "properties": {
          "date": {
            "type": "string",
            "format": "date"
          },
          "temperatureC": {
            "type": "integer",
            "format": "int32"
          },
          "temperatureF": {
            "type": "integer",
            "format": "int32",
            "readOnly": true
          },
          "summary": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      }
    },
    "securitySchemes": {
      "bearer": {
        "type": "http",
        "description": "Enter JWT token only. Do not type Bearer.",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  },
  "security": [
    {
      "bearer": [ ]
