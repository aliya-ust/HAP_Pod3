  "components": {
    "schemas": {
      "ChangePasswordDto": {
        "required": [
          "currentPassword",
          "newPassword"
        ],
        "type": "object",
        "properties": {
          "currentPassword": {
            "minLength": 1,
            "type": "string"
          },
          "newPassword": {
            "minLength": 1,
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "CreateAppointmentDto": {
        "required": [
          "doctorId",
          "patientId",
          "scheduledDate",
          "timeSlot"
        ],
        "type": "object",
        "properties": {
          "patientId": {
            "type": "integer",
            "format": "int32"
          },
          "doctorId": {
            "type": "integer",
            "format": "int32"
          },
          "scheduledDate": {
            "type": "string",
            "format": "date"
          },
          "timeSlot": {
            "maxLength": 20,
            "minLength": 1,
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "CreateDoctorDto": {
        "required": [
          "consultationFee",
          "email",
          "fullName",
          "password",
          "specialisation",
          "yearsOfExperience"
        ],
        "type": "object",
        "properties": {
          "fullName": {
            "maxLength": 100,
            "minLength": 1,
            "pattern": "^[A-Za-z\\s]+$",
            "type": "string"
          },
          "specialisation": {
            "maxLength": 50,
            "minLength": 1,
            "type": "string"
          },
          "email": {
            "maxLength": 100,
            "minLength": 1,
            "type": "string",
            "format": "email"
          },
          "password": {
            "minLength": 1,
            "type": "string"
          },
          "yearsOfExperience": {
            "maximum": 60,
            "minimum": 0,
            "type": "integer",
            "format": "int32"
          },
          "consultationFee": {
            "maximum": 5000,
            "minimum": 0.01,
            "type": "number",
            "format": "double"
          },
          "timeSlots": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "CreateHealthRecordDto": {
        "required": [
          "appointmentId",
          "diagnosis",
          "doctorId",
          "patientId",
          "prescription",
          "visitDate"
        ],
        "type": "object",
        "properties": {
          "appointmentId": {
            "type": "integer",
            "format": "int32"
          },
          "patientId": {
            "type": "integer",
            "format": "int32"
          },
          "doctorId": {
            "type": "integer",
            "format": "int32"
          },
          "visitDate": {
            "type": "string",
            "format": "date-time"
          },
          "diagnosis": {
            "maxLength": 500,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9\\s]+$",
            "type": "string"
          },
          "prescription": {
            "maxLength": 500,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9\\s]+$",
            "type": "string"
          },
          "notes": {
            "maxLength": 1000,
            "pattern": "^[A-Za-z0-9\\s]+$",
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "CreateLeaveDto": {
        "required": [
          "doctorId",
          "leaveDate",
          "reason"
        ],
        "type": "object",
        "properties": {
          "doctorId": {
            "type": "integer",
            "format": "int32"
          },
          "leaveDate": {
            "type": "string",
            "format": "date"
          },
          "reason": {
            "maxLength": 250,
            "minLength": 0,
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "CreatePatientDto": {
        "required": [
          "dateOfBirth",
          "email",
          "fullName",
          "gender",
          "password",
          "phoneNumber"
        ],
        "type": "object",
        "properties": {
          "fullName": {
            "maxLength": 100,
            "minLength": 1,
            "pattern": "^[A-Za-z\\s]+$",
            "type": "string"
          },
          "dateOfBirth": {
            "type": "string",
            "format": "date"
          },
          "gender": {
            "maxLength": 10,
            "minLength": 1,
            "pattern": "^(Male|Female|Other)$",
            "type": "string"
          },
          "phoneNumber": {
            "maxLength": 20,
            "minLength": 1,
