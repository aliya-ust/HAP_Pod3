@page "/home"

<PageTitle>Dashboard</PageTitle>

<h1 class="welcome-title">
    <img src="https://cdn-icons-png.flaticon.com/512/15192/15192779.png" class="card-icon" />
    Welcome Admin
</h1>

<p class="subtitle">
    Manage your healthcare portal efficiently from one centralized dashboard.
</p>

<div class="dashboard">

    <div class="card">
        <h3 class="card-title">
            <img src="https://tse3.mm.bing.net/th/id/OIP._cTE_nqSxTYlrUcwsXuQtgHaHa?rs=1&pid=ImgDetMain&o=7&rm=3" alt="Patient" class="card-icon" />
            Register New Patient
        </h3>
        <p>Add new patients and maintain their profiles.</p>

        <NavLink class="btn btn-primary" href="/registerpatient">
            Open
        </NavLink>
    </div>

    <div class="card">
        <h3 class="card-title">
            <img src="https://tse3.mm.bing.net/th/id/OIP._cTE_nqSxTYlrUcwsXuQtgHaHa?rs=1&pid=ImgDetMain&o=7&rm=3" alt="Doctor" class="card-icon" />
            Register Doctor
        </h3>
        <p>Add doctors and manage their details.</p>

        <NavLink class="btn btn-primary" href="/registerdoctor">
            Open
        </NavLink>
    </div>

    <div class="card center-card">
        <h3 card="card-title">
            <img src="https://tse2.mm.bing.net/th/id/OIP.n0IjVjKiyBj4MtVnM8BBzQHaHa?rs=1&pid=ImgDetMain&o=7&rm=3" alt="Patient" class="card-icon" />
            Appointment Records</h3>
        <p>View and manage appointment history.</p>

        <NavLink class="btn btn-primary" href="/appointmentrecords">
            Open
        </NavLink>
    </div>

</div>

<style>

    .welcome-title {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    font-size: 60px;
    font-weight: 800;
    font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    background: linear-gradient(90deg, #6a11cb, #2575fc);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;

    margin-bottom: 15px;
}

    .subtitle {
        font-size: 18px;
        color: gray;
        margin-bottom: 40px;
    }

    .dashboard {
        display: grid;
        grid-template-columns: repeat(2,1fr);
        gap: 80px;
        max-width: 900px;
        margin: 0 auto;
        margin-top: 70px;
    }

    h1 {
        text-align: center;
        justify-content: center;
    }

    .subtitle {
        text-align: center;
        font-size: 18px;
        color: gray;
        margin-bottom: 40px;
    }

    .center-card {
        grid-column: 1/span 2;
        width: 50%;
        justify-self: center;
    }

    .card {
        background: white;
        padding: 30px;
        border-radius: 18px;
        box-shadow: 0 6px 18px rgba(0,0,0,.15);
    }

        .card:hover {
            transform: translateY(-3px);
            transition: .2s;
        }

    .card-title {
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .card-icon {
        width: 50px;
        height: 50px;
        object-fit: contain;
    }

</style>