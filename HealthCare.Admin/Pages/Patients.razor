@page "/patients"
@inject ConfirmModalService ModalService
@inject ToastService ToastService
@inject PatientService PatientService

<div class="p-4" style="background-color: #f8fafc; min-height: 100vh;">

    <header class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold text-dark mb-1">Patient Management</h2>
            <p class="text-secondary small">Maintain your patient registry and insurance status</p>
        </div>
    </header>

    <div class="bg-white p-3 mb-4 rounded-3 border shadow-sm">
        <div class="row g-2 align-items-center">
            <div class="col-md-4">
                <input class="form-control" placeholder="Search by name..." @bind="searchText" />
            </div>
            <div class="col-md-2">
                <select class="form-select" @bind="insuranceFilter">
                    <option value="">Insurance Type</option>
                    <option value="true">Insured</option>
                    <option value="false">Not Insured</option>
                </select>
            </div>
            <div class="col-md-2">
                <select class="form-select" @bind="statusFilter">
                    <option value="">Status</option>
                    <option value="true">Active</option>
                    <option value="false">Inactive</option>
                </select>
            </div>
            <div class="col-md-2">
                <button class="btn btn-primary w-100" @onclick="ApplyFilters">Search</button>
            </div>
            <div class="col-md-2">
                <button class="btn btn-outline-secondary w-100" @onclick="ResetFilters">Reset</button>
            </div>
        </div>
    </div>

    <AdminTable TItem="PatientListDto" Items="patients" IsLoading="isLoading" EmptyText="No patients found.">
        <HeaderTemplate>
            <th class="ps-4">Patient</th>
            <th>Phone</th>
            <th>Insurance</th>
            <th>Status</th>
            <th class="text-end pe-4">Actions</th>
        </HeaderTemplate>
        <RowTemplate Context="patient">
            <tr>
                <td class="ps-4 fw-semibold">@patient.FullName</td>
                <td>@patient.PhoneNumber</td>
                <td>
                    @if (patient.InsuranceId != null)
                    {
                        <span class="badge bg-success-subtle text-success border">Insured</span>
                    }
                    else
                    {
                        <span class="badge bg-light text-secondary border">Not Insured</span>
                    }
                </td>
                <td>
                    <div class="form-check form-switch">
                        <input class="form-check-input"
                               type="checkbox"
                               checked="@patient.IsActive"
                               @onclick:preventDefault="true"
                               @onclick="() => ConfirmToggleStatus(patient)"
                               style="cursor: pointer;" />
                    </div>
                </td>
                <td class="text-end pe-4">
                    @* <button class="btn btn-sm btn-outline-secondary border-0 me-2" @onclick="() => EditPatient(patient)"><i class="bi bi-pencil"></i></button> *@
                    <button class="btn btn-sm btn-outline-danger border-0" @onclick="() => DeletePatient(patient.PatientId)"><i class="bi bi-trash"></i></button>
                </td>
            </tr>
        </RowTemplate>
    </AdminTable>

    <Pagination PageNumber="pageNumber" TotalPages="totalPages" TotalCount="totalCount"
                PageChanged="async (p) => { pageNumber = p; await LoadData(); }" />
</div>

@* <EditPatientModal @ref="editModal" OnSuccess="LoadData" /> *@

@code {

    private List<PatientListDto> patients = new();
    private bool isLoading = false;

    private string selectedInsurance = "";

    private string searchText = "";
    private string insuranceFilter = "";   // true/false
    private string statusFilter = "";      // true/false

    private int pageNumber = 1;
    private int pageSize = 10;
    private int totalPages = 1;
    private int totalCount = 0;

    private async Task ApplyFilters()
    {
        pageNumber = 1;
        await LoadData();
    }

    private async Task ResetFilters()
    {
        searchText = "";
        insuranceFilter = "";
        statusFilter = "";
        pageNumber = 1;

        await LoadData();
    }

    private async Task ChangePage(int page)
    {
        pageNumber = page;
        await LoadData();
    }



    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        isLoading = true;
        try
        {
            var filter = new PatientFilter
            {
                Search = searchText,
                PageNumber = pageNumber,
                PageSize = pageSize,
                // Clean handling of nullable filters
                HasInsurance = string.IsNullOrEmpty(insuranceFilter) ? null : bool.Parse(insuranceFilter),
                IsActive = string.IsNullOrEmpty(statusFilter) ? null : bool.Parse(statusFilter)
            };

            var result = await PatientService.GetAllAsync(filter);

            patients = result?.Items?.ToList() ?? new List<PatientListDto>();
            totalPages = result?.TotalPages ?? 1;
            totalCount = result?.TotalCount ?? 0;
        }
        catch (Exception ex)
        {
            // Log for debugging
            ToastService.Show("Error", "Could not refresh the patient list.", NotificationType.Error);
        }
        finally
        {
            isLoading = false;
            // Ensure UI updates even if an error occurred
            StateHasChanged();
        }
    }

    private async Task ConfirmToggleStatus(PatientListDto patient)
    {
        // Define the action based on current state
        string action = patient.IsActive ? "deactivate" : "activate";

        // Show the confirmation modal
        bool confirmed = await ModalService.ShowAsync("Confirm Status Change",
            $"Are you sure you want to {action} the account for {patient.FullName}?");

        if (confirmed)
        {
            try
            {
                // Call the PatientService instead of DoctorService
                await PatientService.UpdateStatusAsync(patient.PatientId, !patient.IsActive);

                // Refresh the table data
                await LoadData();
            }
            catch (Exception)
            {
                ToastService.Show("Error", "Failed to update patient status.", NotificationType.Error);
            }
        }
        else
        {
            // Snap back to the correct state in the UI
            StateHasChanged();
        }
    }

    // private void EditPatient(PatientListDto patient)
    // {
    //     var dto = new UpdatePatientDto
    //     {
    //         FullName = patient.FullName,
    //         PhoneNumber = patient.PhoneNumber,
    //         Gender = patient.Gender,
    //         InsuranceId = patient.InsuranceId,
    //     };
    //     editModal.Show(patient.PatientId, dto);
    // }

    private async Task ToggleStatus(PatientListDto patient)
    {
        await PatientService.UpdateStatusAsync(
            patient.PatientId,
            !patient.IsActive
        );

        await LoadData();
    }

    private async Task DeletePatient(int id)
    {
        var confirmed = await ModalService.ShowAsync(
            "Delete Patient",
            "Are you sure you want to delete this patient?"
        );

        if (!confirmed) return;

        try
        {
            await PatientService.DeleteAsync(id);
            await LoadData();
        }
        catch (Exception ex)
        {
            ToastService.Show("Error", "Failed to delete patient.", NotificationType.Error);
        }
    }
}