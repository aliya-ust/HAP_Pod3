@using HealthCare.Api.DTOs.Auth

@page "/profile/change-password"
@* @inject IAuthService AuthService *@
@inject NotificationService ToastService

<div class="container">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card shadow-sm p-4 mt-4">
                <h3 class="mb-3">Change Password</h3>

                <EditForm Model="@changePasswordModel" OnValidSubmit="HandleSubmit">
                    <DataAnnotationsValidator />

                    <div class="form-group mb-3">
                        <label class="form-label" for="currentPassword">Current Password</label>
                        <div class="input-group">
                            <InputText id="currentPassword"
                                       type="@(showCurrent ? "text" : "password")"
                                       class="@("form-control " + (IsInvalid(() => changePasswordModel.CurrentPassword) ? "is-invalid" : ""))"
                                       @bind-Value="changePasswordModel.CurrentPassword" />
                            <span class="input-group-text" role="button" @onclick="() => showCurrent = !showCurrent">
                                <i class="bi @(showCurrent ? "bi-eye-slash" : "bi-eye")"></i>
                            </span>
                        </div>
                        <ValidationMessage For="@(() => changePasswordModel.CurrentPassword)" />
                    </div>

                    <div class="form-group mb-3">
                        <label class="form-label" for="newPassword">New Password</label>
                        <div class="input-group">
                            <InputText id="newPassword"
                                       type="@(showNew ? "text" : "password")"
                                       class="@("form-control " + (IsInvalid(() => changePasswordModel.NewPassword) ? "is-invalid" : ""))"
                                       @bind-Value="changePasswordModel.NewPassword" />
                            <span class="input-group-text" role="button" @onclick="() => showNew = !showNew">
                                <i class="bi @(showNew ? "bi-eye-slash" : "bi-eye")"></i>
                            </span>
                        </div>
                        <ValidationMessage For="@(() => changePasswordModel.NewPassword)" />
                    </div>

                    <button type="submit" class="btn btn-primary" disabled="@isLoading">
                        @if (isLoading)
                        {
                            <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                            <span> Updating...</span>
                        }
                        else
                        {
                            <span>Update Password</span>
                        }
                    </button>
                </EditForm>
            </div>
        </div>
    </div>
</div>

@code {
    private ChangePasswordDto changePasswordModel = new();
    private bool isLoading = false;
    private bool showCurrent = false;
    private bool showNew = false;
    private bool showConfirm = false;
    private EditContext? editContext;

    protected override void OnInitialized()
    {
        editContext = new EditContext(changePasswordModel);
    }

    private bool IsInvalid(System.Linq.Expressions.Expression<Func<string>> accessor)
    {
        if (editContext is null) return false;
        var fieldIdentifier = FieldIdentifier.Create(accessor);
        return editContext.GetValidationMessages(fieldIdentifier).Any();
    }

    private async Task HandleSubmit()
    {
        isLoading = true;
        try
        {
            // var result = await AuthService.ChangePasswordAsync(changePasswordModel);
            // if (result.Success)
            // {
            //     ToastService.ShowSuccess("Password updated successfully.");
            //     changePasswordModel = new();
            // }
            // else
            // {
            //     ToastService.ShowError(result.Message);
            // }
        }
        finally
        {
            isLoading = false;
        }
    }
}