@page "/"
@inject DashboardService DashboardService
@inject ToastService ToastService

@if (_isLoading)
{
    <div class="d-flex justify-content-center align-items-center vh-100">
        <div class="spinner-border text-primary" role="status"></div>
    </div>
}
else if (_hasError)
{
    <div class="alert alert-danger m-4">Error loading dashboard data. Please refresh the page.</div>
}
else
{
    <div class="container-fluid p-4" style="background-color: #f8fafc; min-height: 100vh;">
        <header class="mb-4 d-flex justify-content-between align-items-center">
            <h2 class="fw-bold text-dark">Dashboard</h2>
        </header>

        <div class="row bg-white p-4 rounded-3 shadow-sm mb-4">
            <div class="col-md-3 border-end">
                <StatCard Title="Active Doctors" Value="@_doctorDto.ActiveDoctors.ToString()" />
            </div>
            <div class="col-md-3 border-end">
                <StatCard Title="Active Patients" Value="@_patientDto.ActivePatients.ToString()" />
            </div>
            <div class="col-md-3 border-end">
                <StatCard Title="Completed Appts" Value="@_appointmentDto.CompletedCount.ToString()" />
            </div>
            <div class="col-md-3">
                <StatCard Title="Revenue" Value="@($"₹{_appointmentDto.TotalRevenue:N0}")" />
            </div>
        </div>

        <div class="card p-4 mb-4 shadow-sm">
            <h5 class="fw-semibold mb-4">Appointments Performance (Last 30 Days)</h5>
            <AppointmentBar Label="Completed" Value="_appointmentDto.CompletedCount" CssClass="bg-success" Width="@GetWidth(_appointmentDto.CompletedCount)" />
            <AppointmentBar Label="Confirmed" Value="_appointmentDto.ConfirmedCount" CssClass="bg-info" Width="@GetWidth(_appointmentDto.ConfirmedCount)" />
            <AppointmentBar Label="Pending" Value="_appointmentDto.PendingCount" CssClass="bg-warning" Width="@GetWidth(_appointmentDto.PendingCount)" />
            <AppointmentBar Label="Cancelled" Value="_appointmentDto.CancelledCount" CssClass="bg-danger" Width="@GetWidth(_appointmentDto.CancelledCount)" />
        </div>

        <div class="row g-3">
            <div class="col-md-6">
                <div class="card p-3 shadow-sm">
                    <StatCard Title="Total Doctors" Value="@_doctorDto.TotalDoctors.ToString()" />
                </div>
            </div>
            <div class="col-md-6">
                <div class="card p-3 shadow-sm">
                    <StatCard Title="Total Patients" Value="@_patientDto.TotalPatients.ToString()" />
                </div>
            </div>
        </div>
    </div>
}

@code {
    private DoctorSummaryDto _doctorDto = new();
    private PatientSummaryDto _patientDto = new();
    private AppointmentSummaryDto _appointmentDto = new();
    
    private bool _isLoading = true;
    private bool _hasError = false;

    protected override async Task OnInitializedAsync()
    {
        var timeout = Task.Delay(10000).ContinueWith(_ => { _hasError = true; _isLoading = false; StateHasChanged(); });

        try
        {
            var doctorTask = DashboardService.GetDoctorSummaryAsync();
            var patientTask = DashboardService.GetPatientSummaryAsync();
            var appointmentTask = DashboardService.GetAppointmentSummaryAsync();

            var dataTask = Task.WhenAll(doctorTask, patientTask, appointmentTask);
            var completed = await Task.WhenAny(dataTask, timeout);

            if (completed == dataTask)
            {
                _doctorDto = await doctorTask;
                _patientDto = await patientTask;
                _appointmentDto = await appointmentTask;
            }
        }
        catch
        {
            _hasError = true;
            ToastService.Show("Dashboard Error", "Failed to retrieve system statistics.", NotificationType.Error);
        }
        finally
        {
            _isLoading = false;
            StateHasChanged();
        }
    }

    private int GetMaxVal() => new[] { _appointmentDto.CompletedCount, _appointmentDto.ConfirmedCount, _appointmentDto.PendingCount, _appointmentDto.CancelledCount }.Max();

    private string GetWidth(int value)
    {
        int max = GetMaxVal();
        return max == 0 ? "0%" : $"{(value * 100 / max)}%";
    }
}