@page "/"

<div class="dashboard-wrapper">

    <div class="dashboard-container">

        <!-- Header -->
        <div class="mb-4">
            <h2 class="fw-bold dashboard-title">Dashboard</h2>
        </div>

        <!-- ✅ Top Stats -->
        <div class="row g-4 mb-4">

            <div class="col-md-3">
                <div class="stat-card">
                    <h6>Active Doctors</h6>
                    <h3>@activeDoctors</h3>
                </div>
            </div>

            <div class="col-md-3">
                <div class="stat-card">
                    <h6>Active Patients</h6>
                    <h3>@activePatients</h3>
                </div>
            </div>

            <div class="col-md-3">
                <div class="stat-card">
                    <h6>Completed Appointments</h6>
                    <h3>@completedAppointments</h3>
                </div>
            </div>

            <div class="col-md-3">
                <div class="stat-card highlight">
                    <h6>Revenue</h6>
                    <h3>@revenue.ToString("C0")</h3>
                </div>
            </div>

        </div>

        <!-- ✅ Chart Panel -->
        <div class="main-panel mb-4">
            <h5 class="fw-semibold mb-4">Appointments Performance</h5>

            <div class="custom-bar-chart">

                @foreach (var item in chartData)
                {
                    <div class="bar-row">
                        <span class="label">Completed</span>
                        <div class="bar-container">
                            <div class="bar completed" style="width:@GetWidth(item.Completed)"></div>
                        </div>
                        <span class="value">@item.Completed</span>
                    </div>

                    <div class="bar-row">
                        <span class="label">Confirmed</span>
                        <div class="bar-container">
                            <div class="bar confirmed" style="width:@GetWidth(item.Confirmed)"></div>
                        </div>
                        <span class="value">@item.Confirmed</span>
                    </div>

                    <div class="bar-row">
                        <span class="label">Pending</span>
                        <div class="bar-container">
                            <div class="bar pending" style="width:@GetWidth(item.Pending)"></div>
                        </div>
                        <span class="value">@item.Pending</span>
                    </div>

                    <div class="bar-row">
                        <span class="label">Cancelled</span>
                        <div class="bar-container">
                            <div class="bar cancelled" style="width:@GetWidth(item.Cancelled)"></div>
                        </div>
                        <span class="value">@item.Cancelled</span>
                    </div>
                }

            </div>
        </div>

        <!-- ✅ Bottom Stats -->
        <div class="row g-4">

            <div class="col-md-6">
                <div class="stat-card">
                    <h6>Total Doctors</h6>
                    <h3>@totalDoctors</h3>
                    <div class="small-text">@inactiveDoctors inactive</div>
                </div>
            </div>

            <div class="col-md-6">
                <div class="stat-card">
                    <h6>Total Patients</h6>
                    <h3>@totalPatients</h3>
                    <div class="small-text">@inactivePatients inactive</div>
                </div>
            </div>

        </div>

    </div>
</div>

@code {
    private int activeDoctors = 12;
    private int activePatients = 48;
    private int completedAppointments = 32;
    private decimal revenue = 25600;
    private int totalDoctors = 15;
    private int inactiveDoctors = 3;
    private int totalPatients = 60;
    private int inactivePatients = 12;

    private List<ChartData> chartData = new() { new ChartData { Completed = 32, Confirmed = 20, Pending = 10, Cancelled = 5 } };
    private double maxValue = 40;

    private string GetWidth(int value) => $"{(value / maxValue) * 100}%";

    public class ChartData
    {
        public int Completed { get; set; }
        public int Confirmed { get; set; }
        public int Pending { get; set; }
        public int Cancelled { get; set; }
    }
}