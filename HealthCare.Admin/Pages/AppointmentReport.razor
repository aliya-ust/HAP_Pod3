@page "/appointments-report"
@inject ToastService ToastService
@inject AppointmentService AppointmentService

<div class="p-4" style="background-color: #f8fafc; min-height: 100vh;">
    <header class="mb-4">
        <h2 class="fw-bold text-dark mb-1">Appointments Report</h2>
        <p class="text-secondary small">Analyze appointment trends for a 7-day period</p>
    </header>

    <div class="bg-white p-3 mb-4 rounded-3 border shadow-sm">
        <div class="row g-2 align-items-center">
            <div class="col-md-3">
                <label class="form-label small fw-bold text-uppercase text-muted">From</label>
                <input type="date" class="form-control"
                       @bind="fromDate"
                       @bind:after="OnFromDateChanged"
                       min="@FromDateMin"
                       max="@FromDateMax" />
            </div>
            <div class="col-md-3">
                <label class="form-label small fw-bold text-uppercase text-muted">To</label>
                <input type="date" class="form-control"
                       @bind="toDate"
                       @bind:after="OnToDateChanged"
                       min="@ToDateMin"
                       max="@ToDateMax" />
            </div>
            <div class="col-md-2 mt-4">
                <button class="btn btn-primary w-100" @onclick="GenerateReport">Generate Report</button>
            </div>
        </div>
    </div>

    <AdminTable TItem="AppointmentReportDto" Items="reports" IsLoading="isLoading" EmptyText="Select a date range to view report.">
        <HeaderTemplate>
            <th class="ps-4">Date</th>
            <th>Pending</th>
            <th>Confirmed</th>
            <th>Cancelled</th>
            <th>Completed</th>
            <th class="text-end pe-4">Total</th>
        </HeaderTemplate>
        <RowTemplate Context="report">
            <tr>
                <td class="ps-4 fw-semibold">@report.Date.ToString("dd MMM yyyy")</td>
                <td><span class="badge bg-warning-subtle text-dark border">@report.PendingCount</span></td>
                <td><span class="badge bg-primary-subtle text-primary border">@report.ConfirmedCount</span></td>
                <td><span class="badge bg-danger-subtle text-danger border">@report.CancelledCount</span></td>
                <td><span class="badge bg-success-subtle text-success border">@report.CompletedCount</span></td>
                <td class="text-end pe-4 fw-bold">@(report.PendingCount + report.ConfirmedCount + report.CancelledCount + report.CompletedCount)</td>
            </tr>
        </RowTemplate>
    </AdminTable>
</div>

@code {
    private List<AppointmentReportDto> reports = new();
    private bool isLoading = false;

    private DateOnly fromDate = DateOnly.FromDateTime(DateTime.Today.AddDays(-6));
    private DateOnly toDate = DateOnly.FromDateTime(DateTime.Today);

    private string FromDateMax
    {
        get
        {
            var today = DateOnly.FromDateTime(DateTime.Today);
            if (toDate == default) return today.ToString("yyyy-MM-dd");
            return (toDate < today ? toDate : today).ToString("yyyy-MM-dd");
        }
    }

    private string? FromDateMin
    {
        get
        {
            if (toDate == default) return null;
            return toDate.AddDays(-7).ToString("yyyy-MM-dd");
        }
    }

    private string? ToDateMin
    {
        get
        {
            if (fromDate == default) return null;
            return fromDate.ToString("yyyy-MM-dd");
        }
    }

    private string ToDateMax
    {
        get
        {
            var today = DateOnly.FromDateTime(DateTime.Today);
            if (fromDate == default) return today.ToString("yyyy-MM-dd");
            var maxAllowed = fromDate.AddDays(7);
            var capped = maxAllowed < today ? maxAllowed : today;
            return capped.ToString("yyyy-MM-dd");
        }
    }

    private void OnFromDateChanged()
    {
        var maxTo = fromDate.AddDays(7);
        var today = DateOnly.FromDateTime(DateTime.Today);
        if (toDate > maxTo)
            toDate = maxTo > today ? today : maxTo;
    }

    private void OnToDateChanged()
    {
        var minFrom = toDate.AddDays(-7);
        if (fromDate < minFrom)
            fromDate = minFrom;
    }

    private async Task GenerateReport()
    {
        await LoadData();
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        isLoading = true;
        try
        {
            var filter = new AppointmentReportFilter
            {
                FromDate = fromDate,
                ToDate = toDate
            };

            reports = await AppointmentService.GetReportAsync(filter);
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }
}
