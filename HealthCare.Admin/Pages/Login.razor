@using HealthCare.Api.DTOs.Auth

@page "/login"
@* @inject IAuthService AuthService *@
@layout EmptyLayout
@inject NotificationService ToastService
@inject NavigationManager NavManager

<div class="d-flex justify-content-center align-items-center" style="min-height: 100vh; min-width: 100vw">
    <div class="col-md-6 col-lg-4">
        <div class="card shadow-sm p-4">
            <div class="text-center mb-3">
                <h3>Admin Portal</h3>
                <p class="text-muted">Sign in to continue</p>
            </div>

            <EditForm Model="@loginModel" OnValidSubmit="HandleSubmit">
                <DataAnnotationsValidator />

                <div class="form-group mb-3">
                    <label class="form-label" for="email">Email</label>
                    <InputText id="email" class="form-control" @bind-Value="loginModel.Email" />
                    <ValidationMessage For="@(() => loginModel.Email)" />
                </div>

                <div class="form-group mb-3">
                    <label class="form-label" for="password">Password</label>
                    <div class="input-group">
                        <InputText id="password"
                                   type="@(showPassword ? "text" : "password")"
                                   class="form-control"
                                   @bind-Value="loginModel.Password" />
                        <span class="input-group-text" role="button" @onclick="TogglePasswordVisibility">
                            <i class="bi @(showPassword ? "bi-eye-slash" : "bi-eye")"></i>
                        </span>
                    </div>
                    <ValidationMessage For="@(() => loginModel.Password)" />
                </div>

                <button type="submit" class="btn btn-primary w-100" disabled="@isLoading">
                    @if (isLoading)
                    {
                        <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                        <span> Authenticating...</span>
                    }
                    else
                    {
                        <span>Sign In</span>
                    }
                </button>
            </EditForm>
        </div>
    </div>
</div>

@code {
    private LoginDto loginModel = new();
    private bool isLoading = false;
    private bool showPassword = false;

    private void TogglePasswordVisibility()
    {
        showPassword = !showPassword;
    }

    private async Task HandleSubmit()
    {
        isLoading = true;
        try
        {
            // var result = await AuthService.LoginAsync(loginModel);
            // if (result.Success)
            // {
            //     NavManager.NavigateTo("/dashboard");
            // }
            // else
            // {
            //     ToastService.ShowError(result.Message);
            // }
        }
        finally
        {
            isLoading = false;
        }
    }
}