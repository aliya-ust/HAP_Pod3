@page "/doctors"
@inject ToastService ToastService
@inject DoctorService DoctorService
@inject ConfirmModalService ModalService

<div class="p-4" style="background-color: #f8fafc; min-height: 100vh;">

    <header class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold text-dark mb-1">Doctor Management</h2>
            <p class="text-secondary small">Maintain your clinical staff registry</p>
        </div>
        <button class="btn btn-primary px-4 shadow-sm" @onclick="() => addModal.Show()">
            <i class="bi bi-plus-lg me-2"></i> Add Doctor
        </button>
    </header>

    <div class="bg-white p-3 mb-4 rounded-3 border shadow-sm">
        <div class="row g-2 align-items-center">
            <div class="col-md-3">
                <input class="form-control" placeholder="Search by name..." @bind="searchText" @oninput="HandleSearchInput" />
            </div>
            <div class="col-md-2">
                <select class="form-select" @bind="selectedSpecialisation">
                    <option value="">All Specs</option>
                    @foreach (var spec in specialisations)
                    {
                        <option value="@spec">@spec</option>
                    }
                </select>
            </div>
            <div class="col-md-2">
                <select class="form-select" @bind="isDescending">
                    <option value="">Order: Default</option>
                    <option value="false">Experience: Low to High</option>
                    <option value="true">Experience: High to Low</option>
                </select>
            </div>
            <div class="col-md-2">
                <select class="form-select" @bind="isActiveFilter">
                    <option value="">Status</option>
                    <option value="true">Active</option>
                    <option value="false">Inactive</option>
                </select>
            </div>
            <div class="col-md-2">
                <button class="btn btn-primary w-100" @onclick="ApplyFilters">Search</button>
            </div>
        </div>
    </div>

    <AdminTable TItem="DoctorListDto" Items="doctors" IsLoading="isLoading" EmptyText="No doctors found.">
        <HeaderTemplate>
            <th class="ps-4">Doctor</th>
            <th>Specialisation</th>
            <th>Experience</th>
            <th>Fee</th>
            <th>Status</th>
            <th class="text-end pe-4">Actions</th>
        </HeaderTemplate>
        <RowTemplate Context="doctor">
            <tr>
                <td class="ps-4 fw-semibold">@doctor.FullName</td>
                <td><span class="badge bg-light text-dark border">@doctor.Specialisation</span></td>
                <td>@doctor.YearsOfExperience yrs</td>
                <td class="text-primary">@($"₹{doctor.ConsultationFee:N0}")</td>
                <td>
                    <div class="form-check form-switch">
                        <input class="form-check-input" type="checkbox"
                               checked="@doctor.IsActive"
                               @onclick:preventDefault="true"
                               @onclick="() => ConfirmToggleStatus(doctor)"
                               style="cursor: pointer;" />
                    </div>
                </td>
                <td class="text-end pe-4">
                    <button class="btn btn-sm btn-outline-secondary border-0 me-2" @onclick="() => EditDoctor(doctor)"><i class="bi bi-pencil"></i></button>
                    <button class="btn btn-sm btn-outline-danger border-0" @onclick="() => DeleteDoctor(doctor.DoctorId)"><i class="bi bi-trash"></i></button>
                </td>
            </tr>
        </RowTemplate>
    </AdminTable>

    <Pagination PageNumber="pageNumber" TotalPages="totalPages" TotalCount="totalCount"
                PageChanged="async (p) => { pageNumber = p; await LoadData(); }" />
</div>

<AddDoctorModal @ref="addModal" OnSuccess="LoadData" />
<EditDoctorModal @ref="editModal" OnSuccess="LoadData" />

@code {
    private List<DoctorListDto> doctors = new();
    private IReadOnlyList<string> specialisations = new List<string>();
    private bool isLoading = false;

    // Component References
    private AddDoctorModal addModal;
    private EditDoctorModal editModal;

    // Filters & Pagination
    private string searchText = "";
    private string selectedSpecialisation = "";
    private string isDescending = "";
    private string isActiveFilter = "";
    private int pageNumber = 1;
    private int pageSize = 10;
    private int totalPages = 1;
    private int totalCount = 0;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            // Load filters and initial data
            specialisations = DoctorConstants.Specialisations;
            await LoadData();
        }
        catch (Exception)
        {
            // Assuming you have a ToastService injected
            ToastService.Show("Error", "Failed to load doctor data.", NotificationType.Error);
        }
    }

    private async Task LoadData()
    {
        isLoading = true;
        try
        {
            var filter = new DoctorFilter
            {
                Search = searchText,
                Specialisation = selectedSpecialisation,
                SortBy = "experience",
                IsDescending = string.IsNullOrEmpty(isDescending) ? false : bool.Parse(isDescending),
                PageNumber = pageNumber,
                PageSize = pageSize,
                IsActive = string.IsNullOrEmpty(isActiveFilter) ? null : bool.Parse(isActiveFilter)
            };

            var result = await DoctorService.GetAllAsync(filter);
            doctors = result.Items.ToList();
            totalPages = result.TotalPages;
            totalCount = result.TotalCount;
        }
        catch (Exception)
        {
            ToastService.Show("Error", "Could not refresh the doctor list.", NotificationType.Error);
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task ConfirmToggleStatus(DoctorListDto doctor)
    {
        string action = doctor.IsActive ? "deactivate" : "activate";

        // Show the modal
        bool confirmed = await ModalService.ShowAsync("Confirm Status Change",
            $"Are you sure you want to {action} {doctor.FullName}?");

        if (confirmed)
        {
            // If confirmed, update the API
            try
            {
                await DoctorService.UpdateStatusAsync(doctor.DoctorId, !doctor.IsActive);
                await LoadData(); // Refresh to reflect new database state
            }
            catch (Exception)
            {
                ToastService.Show("Error", "Failed to update status.", NotificationType.Error);
            }
        }
        else
        {
            // If cancelled, force a re-render to "snap" the checkbox back
            // to its original state if it accidentally flickered
            StateHasChanged();
        }
    }

    private void EditDoctor(DoctorListDto doctor)
    {
        var dto = new UpdateDoctorDto
        {
            FullName = doctor.FullName,
            Specialisation = doctor.Specialisation,
            YearsOfExperience = doctor.YearsOfExperience
        };
        editModal.Show(doctor.DoctorId, dto);
    }

    private async Task DeleteDoctor(int id)
    {
        if (await ModalService.ShowAsync("Delete Doctor", "This action cannot be undone. Proceed?"))
        {
            await DoctorService.DeleteAsync(id);
            await LoadData();
        }
    }

    private async Task ApplyFilters()
    {
        pageNumber = 1;
        await LoadData();
    }

    private void HandleSearchInput(ChangeEventArgs e)
    {
        searchText = e.Value?.ToString() ?? "";
    }
}