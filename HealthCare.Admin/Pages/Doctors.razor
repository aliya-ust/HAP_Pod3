@using HealthCare.Admin.Components
@using HealthCare.Api.DTOs.Doctor
@using HealthCare.Admin.Shared


@page "/doctors"
@inject ConfirmModalService ModalService

<div class="container-fluid py-4">

    <!-- Page Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1">Doctor Management</h2>
            <p class="text-muted mb-0">Manage doctors, availability, and details</p>
        </div>

        <button class="btn btn-primary shadow-sm px-3" @onclick="() => addModal.Show()">
            <i class="bi bi-plus-lg me-2"></i> Add Doctor
        </button>
    </div>

    <!-- Filters + Stats -->
    <div class="row mb-4">

        <!-- Filter Card -->
        <div class="col-md-4">
            <div class="card shadow-sm border-0 rounded-4">
                <div class="card-body">
                    <label class="form-label fw-semibold text-muted small">FILTER BY SPECIALISATION</label>
                    <select class="form-select"
                            @bind="selectedSpecialisation"
                            @bind:after="LoadData">
                        <option value="">All Specialisations</option>
                        @foreach (var spec in specialisations)
                        {
                            <option value="@spec">@spec</option>
                        }
                    </select>
                </div>
            </div>
        </div>

        <!-- Optional Stats Cards -->
        <div class="col-md-8">
            <div class="row g-3">
                <div class="col">
                    <div class="card shadow-sm border-0 rounded-4 text-center p-3">
                        <h6 class="text-muted">Total Doctors</h6>
                        <h4 class="fw-bold">@doctors.Count</h4>
                    </div>
                </div>
                <div class="col">
                    <div class="card shadow-sm border-0 rounded-4 text-center p-3">
                        <h6 class="text-muted">Active</h6>
                        <h4 class="fw-bold text-success">
                            @doctors.Count(d => d.IsActive)
                        </h4>
                    </div>
                </div>
                <div class="col">
                    <div class="card shadow-sm border-0 rounded-4 text-center p-3">
                        <h6 class="text-muted">Inactive</h6>
                        <h4 class="fw-bold text-secondary">
                            @doctors.Count(d => !d.IsActive)
                        </h4>
                    </div>
                </div>
            </div>
        </div>

    </div>

    <!-- Table Card -->
    <div class="card shadow-sm border-0 rounded-4">
        <div class="card-body p-0">

            <AdminTable TItem="DoctorListDto"
                        Items="doctors"
                        IsLoading="isLoading"
                        ColumnCount="6"
                        EmptyText="No doctors match the selected filter.">

                <!-- Table Header -->
                <HeaderTemplate>
                    <th class="ps-4">Name</th>
                    <th>Specialisation</th>
                    <th>Experience</th>
                    <th>Fee</th>
                    <th>Status</th>
                    <th class="text-end pe-4">Actions</th>
                </HeaderTemplate>

                <!-- Table Rows -->
                <RowTemplate Context="doctor">
                    <tr class="align-middle">

                        <td class="ps-4 fw-semibold">
                            @doctor.FullName
                        </td>

                        <td>
                            <span class="badge bg-light text-dark border">
                                @doctor.Specialisation
                            </span>
                        </td>

                        <td>
                            @doctor.YearsOfExperience yrs
                        </td>

                        <td class="fw-semibold text-primary">
                            @doctor.ConsultationFee.ToString("C")
                        </td>

                        <td>
                            @if (doctor.IsActive)
                            {
                                <span class="badge bg-success-subtle text-success">
                                    ● Active
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-secondary-subtle text-secondary">
                                    ● Inactive
                                </span>
                            }
                        </td>

                        <td class="text-end pe-4">
                            <div class="d-flex justify-content-end gap-2">

                                <button class="btn btn-light border rounded-circle p-2"
                                        title="View"
                                        @onclick="() => ViewDoctor(doctor.DoctorId)">
                                    <i class="bi bi-eye fs-5"></i>
                                </button>

                                <button class="btn btn-light border rounded-circle p-2"
                                        title="Edit"
                                        @onclick="() => EditDoctor(doctor)">
                                    <i class="bi bi-pencil fs-5"></i>
                                </button>

                                <button class="btn btn-light border rounded-circle p-2 text-danger"
                                        title="Delete"
                                        @onclick="() => DeleteDoctor(doctor.DoctorId)">
                                    <i class="bi bi-trash fs-5"></i>
                                </button>

                            </div>
                        </td>
                    </tr>
                </RowTemplate>

            </AdminTable>
        </div>
    </div>

</div>

<!-- Modals -->
<AddDoctorModal @ref="addModal" OnSuccess="LoadData" />
<EditDoctorModal @ref="editModal" OnSuccess="LoadData" />

