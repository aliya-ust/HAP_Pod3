@using System.Linq.Expressions

<div class="form-group mb-3">
    @if (!string.IsNullOrEmpty(Label))
    {
        <label class="form-label" for="@Id">@Label</label>
    }
    <InputText id="@Id"
               class="@("form-control " + (ShowValidation ? "is-invalid" : ""))"
               @bind-Value="Value"
               @bind-Value:after="OnValueChangedInternal"
               placeholder="@Placeholder" />
    @if (ValueExpression is not null)
    {
        <ValidationMessage For="ValueExpression" />
    }
</div>

@code {
    [Parameter] public string? Id { get; set; } = Guid.NewGuid().ToString("N");
    [Parameter] public string Label { get; set; } = string.Empty;
    [Parameter] public string Placeholder { get; set; } = string.Empty;

    [Parameter] public string Value { get; set; } = string.Empty;
    [Parameter] public EventCallback<string> ValueChanged { get; set; }
    [Parameter] public Expression<Func<string>>? ValueExpression { get; set; }

    [CascadingParameter] private EditContext? CascadedEditContext { get; set; }

    private bool ShowValidation =>
        ValueExpression is not null
        && CascadedEditContext is not null
        && CascadedEditContext.GetValidationMessages(FieldIdentifier.Create(ValueExpression)).Any();

    private async Task OnValueChangedInternal()
    {
        await ValueChanged.InvokeAsync(Value);
    }
}