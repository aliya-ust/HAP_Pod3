@inject ConfirmModalService ModalService
@implements IDisposable

@if (isVisible)
{
    <div class="modal d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">@title</h5>
                    <button type="button" class="btn-close" @onclick="() => Resolve(false)"></button>
                </div>
                <div class="modal-body">
                    <p class="mb-0">@message</p>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="() => Resolve(false)">Cancel</button>
                    <button class="btn btn-danger" @onclick="() => Resolve(true)">Confirm</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private bool isVisible = false;
    private string title = string.Empty;
    private string message = string.Empty;
    private TaskCompletionSource<bool>? tcs;

    protected override void OnInitialized()
    {
        ModalService.OnShow += HandleShow;
    }

    private Task<bool> HandleShow(string t, string m)
    {
        title = t;
        message = m;
        isVisible = true;
        tcs = new TaskCompletionSource<bool>();
        StateHasChanged();
        return tcs.Task;
    }

    private void Resolve(bool result)
    {
        isVisible = false;
        tcs?.TrySetResult(result);
    }

    public void Dispose()
    {
        ModalService.OnShow -= HandleShow;
    }
}