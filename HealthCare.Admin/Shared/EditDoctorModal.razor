@using HealthCare.Api.DTOs.Doctor

@if (isVisible)
{
    <div class="modal d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Edit Doctor</h5>
                    <button type="button" class="btn-close" @onclick="Close"></button>
                </div>
                <div class="modal-body">
                    <EditForm Model="updateDto" OnValidSubmit="HandleSubmit">
                        <DataAnnotationsValidator />

                        <div class="mb-3">
                            <label class="form-label">Full Name</label>
                            <InputText class="form-control" @bind-Value="updateDto.FullName" />
                            <ValidationMessage For="@(() => updateDto.FullName)" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Specialisation</label>
                            <InputText class="form-control" @bind-Value="updateDto.Specialisation" />
                            <ValidationMessage For="@(() => updateDto.Specialisation)" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Years of Experience</label>
                            <InputNumber class="form-control" @bind-Value="updateDto.YearsOfExperience" />
                            <ValidationMessage For="@(() => updateDto.YearsOfExperience)" />
                        </div>

                        <div class="modal-footer">
                            <button type="button" class="btn btn-secondary" @onclick="Close">Cancel</button>
                            <button type="submit" class="btn btn-primary">Save Changes</button>
                        </div>
                    </EditForm>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public EventCallback OnSuccess { get; set; }
    private UpdateDoctorDto updateDto = new();
    private int currentDoctorId;
    private bool isVisible = false;

    // Call this method from the parent page
    public void Show(int id, UpdateDoctorDto existingData)
    {
        currentDoctorId = id;
        // Map existing data to the DTO
        updateDto = new UpdateDoctorDto
        {
            FullName = existingData.FullName,
            Specialisation = existingData.Specialisation,
            YearsOfExperience = existingData.YearsOfExperience
        };
        isVisible = true;
    }

    private void Close() => isVisible = false;

    private async Task HandleSubmit()
    {
        // Use currentDoctorId to call your service
        // await DoctorService.UpdateAsync(currentDoctorId, updateDto);

        await OnSuccess.InvokeAsync();
        Close();
    }
}