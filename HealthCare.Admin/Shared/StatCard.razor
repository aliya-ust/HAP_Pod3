<div class="stat-metric">
    <small class="text-uppercase text-muted fw-bold d-block mb-1" style="font-size: 0.65rem; letter-spacing: 0.05em;">@Title</small>
    <div class="h3 fw-normal" style="color: #212529;">@Value</div>
</div>

@code {
    [Parameter] public string Title { get; set; } = "";
    [Parameter] public string Value { get; set; } = "";
}