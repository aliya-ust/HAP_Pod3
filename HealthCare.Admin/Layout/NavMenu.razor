<div class="layout-wrapper">

    <!-- Sidebar -->
    <div class="sidebar-container @NavMenuCssClass">

        <!-- Logo -->
        <div class="logo">
            <i class="bi bi-heart-pulse"></i>
            <span>HealthCare Management</span>
        </div>

        <!-- Navigation -->
        <nav class="nav flex-column">

            <NavLink class="nav-item-link" href="" Match="NavLinkMatch.All">
                <i class="bi bi-speedometer2"></i>
                <span>Dashboard</span>
            </NavLink>

            <NavLink class="nav-item-link" href="doctors">
                <i class="bi bi-person-badge"></i>
                <span>Doctors</span>
            </NavLink>

            <NavLink class="nav-item-link" href="patients">
                <i class="bi bi-people"></i>
                <span>Patients</span>
            </NavLink>

            <div class="nav-divider">Analytics</div>

            <NavLink class="nav-item-link" href="appointments-report">
                <i class="bi bi-bar-chart-line"></i>
                <span>Appointments</span>
            </NavLink>

        </nav>

    </div>

</div>

@code {
    private bool collapseNavMenu = true;
    private string? NavMenuCssClass => collapseNavMenu ? "collapse" : null;
    private void ToggleNavMenu() => collapseNavMenu = !collapseNavMenu;
}
