@using HealthCare.Admin.Shared
@inject ToastService ToastService
@implements IDisposable

@inherits LayoutComponentBase
<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <div class="toast-container position-fixed top-0 end-0 p-3">
        @foreach (var note in _messages)
        {
            <div class="toast show" role="alert">
                <div class="toast-header">
                    <strong class="me-auto">@note.Title</strong>
                    <button type="button" class="btn-close" @onclick="() => RemoveMessage(note)"></button>
                </div>
                <div class="toast-body">@note.Message</div>
            </div>
        }
    </div>

    <ConfirmModal />

    <main>

        <article class="content px-4">
            <ErrorBoundary @ref="errorBoundary">
                <ChildContent>
                    @Body
                </ChildContent>
                <ErrorContent>
                    <div class="alert alert-danger">
                        <h3>Something went wrong!</h3>
                        <p>We've logged the error and are working on it.</p>
                        <button class="btn btn-primary" @onclick="() => errorBoundary?.Recover()">Try Again</button>
                    </div>
                </ErrorContent>
            </ErrorBoundary>
        </article>
    </main>
</div>

@code {
    private ErrorBoundary? errorBoundary;

    private List<NotificationMessage> _messages = new();

    protected override void OnInitialized()
        => ToastService.OnNotificationReceived += HandleNotification;

    private void HandleNotification(NotificationMessage note)
    {
        _messages.Add(note);                              
        StateHasChanged();

        // Auto-remove after 3 seconds
        Task.Delay(3000).ContinueWith(_ => InvokeAsync(() => RemoveMessage(note)));
    }

    private void RemoveMessage(NotificationMessage note)
    {
        _messages.Remove(note);
        StateHasChanged();
    }

    public void Dispose()
        => ToastService.OnNotificationReceived -= HandleNotification;
}