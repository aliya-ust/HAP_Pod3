@using HealthCare.Shared.DTOs.Doctor
@inject DoctorService DoctorService
@inject ToastService ToastService

@if (isVisible)
{
    <div class="modal-backdrop show" style="background: rgba(30, 41, 59, 0.5); backdrop-filter: blur(2px);"></div>

    <div class="modal fade show d-block" tabindex="-1">
        <div class="modal-dialog modal-lg modal-dialog-centered">
            <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden">

                <div class="modal-header bg-slate-800 text-white p-4 border-0">
                    <h5 class="modal-title fw-bold">Edit Doctor Profile</h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="Close"></button>
                </div>

                <div class="modal-body p-4 bg-white">
                    <EditForm Model="updateDto" OnValidSubmit="HandleSubmit">
                        <DataAnnotationsValidator />

                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label text-muted small fw-bold text-uppercase">Full Name</label>
                                <InputText class="form-control bg-light border-0" @bind-Value="updateDto.FullName" />
                            </div>

                            <div class="col-md-6">
                                <label class="form-label text-muted small fw-bold text-uppercase">Specialisation</label>
                                <InputSelect class="form-select bg-light border-0" @bind-Value="updateDto.Specialisation">
                                    <option value="">Select Specialisation</option>
                                    @foreach (var spec in specialisations)
                                    {
                                        <option value="@spec">@spec</option>
                                    }
                                </InputSelect>
                            </div>

                            <div class="col-md-6">
                                <label class="form-label text-muted small fw-bold text-uppercase">Years of Experience</label>
                                <InputNumber class="form-control bg-light border-0" @bind-Value="updateDto.YearsOfExperience" />
                            </div>
                        </div>

                        <div class="d-flex justify-content-end gap-2 mt-4 pt-3 border-top">
                            <button type="button" class="btn btn-light px-4" @onclick="Close">Cancel</button>
                            <button type="submit" class="btn btn-dark px-4" disabled="@isSaving">@(isSaving ? "Saving..." : "Save Changes")</button>
                        </div>
                    </EditForm>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public EventCallback OnSuccess { get; set; }

    private UpdateDoctorDto updateDto = new();
    private bool isVisible = false;
    private List<string> specialisations = new();
    private int doctorId;
    private bool isSaving = false;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            // Load filters and initial data
            specialisations = DoctorConstants.Specialisations;
        }
        catch (Exception)
        {
            // Assuming you have a ToastService injected
            ToastService.Show("Error", "Failed to load doctor data.", NotificationType.Error);
        }
    }


    public void Show(int id, UpdateDoctorDto dto)
    {
        doctorId = id;
        updateDto = new UpdateDoctorDto
        {
            FullName = dto.FullName,
            Specialisation = dto.Specialisation,
            YearsOfExperience = dto.YearsOfExperience
        };

        isVisible = true;
        StateHasChanged();
    }

    private void Close()
    {
        isVisible = false;
    }

    private async Task HandleSubmit()
    {
        isSaving = true;
        try
        {
            await DoctorService.UpdateAsync(doctorId, updateDto);
            await OnSuccess.InvokeAsync();
            Close();
        }
        catch (Exception ex)
        {
            ToastService.Show("Error", "Failed to update doctor.", NotificationType.Error);
        }
        finally
        {
            isSaving = false;
        }
    }
}