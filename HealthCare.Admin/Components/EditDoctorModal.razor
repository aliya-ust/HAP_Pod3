@using HealthCare.Api.DTOs.Doctor

@if (isVisible)
{
    <div class="modal fade show d-block">
        <div class="modal-dialog modal-lg modal-dialog-centered">
            <div class="modal-content shadow-lg border-0 rounded-4">

                <!-- Header -->
                <div class="modal-header bg-secondary text-white rounded-top-4">
                    <h5 class="modal-title fw-bold">Edit Doctor</h5>
                    <button class="btn-close btn-close-white" @onclick="Close"></button>
                </div>

                <!-- Body -->
                <div class="modal-body p-4">

                    <EditForm Model="updateDto" OnValidSubmit="HandleSubmit">
                        <DataAnnotationsValidator />
                        <ValidationSummary class="text-danger mb-3" />

                        <div class="row g-3">

                            <!-- Full Name -->
                            <div class="col-md-6">
                                <label class="form-label fw-semibold">Full Name</label>
                                <InputText class="form-control" @bind-Value="updateDto.FullName" />
                                <ValidationMessage For="@(() => updateDto.FullName)" />
                            </div>

                            <!-- Specialisation -->
                            <div class="col-md-6">
                                <label class="form-label fw-semibold">Specialisation</label>
                                <InputText class="form-control" @bind-Value="updateDto.Specialisation" />
                                <ValidationMessage For="@(() => updateDto.Specialisation)" />
                            </div>

                            <!-- Experience -->
                            <div class="col-md-6">
                                <label class="form-label fw-semibold">Years of Experience</label>
                                <InputNumber class="form-control" @bind-Value="updateDto.YearsOfExperience" />
                                <ValidationMessage For="@(() => updateDto.YearsOfExperience)" />
                            </div>

                        </div>

                        <div class="d-flex justify-content-end gap-2 mt-4">
                            <button type="button" class="btn btn-outline-secondary" @onclick="Close">Cancel</button>
                            <button type="submit" class="btn btn-secondary px-4">Update</button>
                        </div>

                    </EditForm>

                </div>
            </div>
        </div>
    </div>

    <div class="modal-backdrop fade show"></div>
}

@code {
    [Parameter] public EventCallback OnSuccess { get; set; }

    private UpdateDoctorDto updateDto = new();
    private bool isVisible = false;
    private int doctorId;

    public void Show(int id, UpdateDoctorDto dto)
    {
        doctorId = id;
        updateDto = new UpdateDoctorDto
        {
            FullName = dto.FullName,
            Specialisation = dto.Specialisation,
            YearsOfExperience = dto.YearsOfExperience
        };

        isVisible = true;
        StateHasChanged();
    }

    private void Close()
    {
        isVisible = false;
    }

    private async Task HandleSubmit()
    {
        // await DoctorService.UpdateAsync(doctorId, updateDto);

        await OnSuccess.InvokeAsync();
        Close();
    }
}
``