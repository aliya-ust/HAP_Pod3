@using HealthCare.Api.DTOs.Patient

@if (isVisible)
{
    <div class="modal fade show d-block">
        <div class="modal-dialog modal-lg modal-dialog-centered">
            <div class="modal-content shadow-lg border-0 rounded-4">

                <!-- Header -->
                <div class="modal-header bg-secondary text-white rounded-top-4">
                    <h5 class="modal-title fw-bold">Edit Patient</h5>
                    <button class="btn-close btn-close-white" @onclick="Close"></button>
                </div>

                <!-- Body -->
                <div class="modal-body p-4">

                    <EditForm Model="updateDto" OnValidSubmit="HandleSubmit">
                        <DataAnnotationsValidator />
                        <ValidationSummary class="text-danger mb-3" />

                        <div class="row g-3">

                            <!-- Full Name -->
                            <div class="col-md-6">
                                <label class="form-label fw-semibold">Full Name</label>
                                <InputText class="form-control" @bind-Value="updateDto.FullName" />
                                <ValidationMessage For="@(() => updateDto.FullName)" />
                            </div>

                            <!-- Email -->
                            <div class="col-md-6">
                                <label class="form-label fw-semibold">Email</label>
                                <InputText class="form-control" @bind-Value="updateDto.Email" />
                                <ValidationMessage For="@(() => updateDto.Email)" />
                            </div>

                            <!-- Phone -->
                            <div class="col-md-6">
                                <label class="form-label fw-semibold">Phone Number</label>
                                <InputText class="form-control" @bind-Value="updateDto.PhoneNumber" />
                                <ValidationMessage For="@(() => updateDto.PhoneNumber)" />
                            </div>

                            <!-- Gender -->
                            <div class="col-md-6">
                                <label class="form-label fw-semibold">Gender</label>
                                <InputSelect class="form-select" @bind-Value="updateDto.Gender">
                                    <option value="">-- Select --</option>
                                    <option>Male</option>
                                    <option>Female</option>
                                    <option>Other</option>
                                </InputSelect>
                                <ValidationMessage For="@(() => updateDto.Gender)" />
                            </div>

                            <!-- Insurance -->
                            <div class="col-md-6">
                                <label class="form-label fw-semibold">Insurance ID</label>
                                <InputText class="form-control" @bind-Value="updateDto.InsuranceId" />
                                <ValidationMessage For="@(() => updateDto.InsuranceId)" />
                            </div>

                        </div>

                        <div class="d-flex justify-content-end gap-2 mt-4">
                            <button type="button" class="btn btn-outline-secondary" @onclick="Close">Cancel</button>
                            <button type="submit" class="btn btn-secondary px-4">Update</button>
                        </div>

                    </EditForm>

                </div>
            </div>
        </div>
    </div>

    <div class="modal-backdrop fade show"></div>
}

@code {
    [Parameter] public EventCallback OnSuccess { get; set; }

    private UpdatePatientDto updateDto = new();
    private bool isVisible = false;
    private int patientId;

    public void Show(int id, UpdatePatientDto dto)
    {
        patientId = id;
        updateDto = new UpdatePatientDto
        {
            FullName = dto.FullName,
            Email = dto.Email,
            PhoneNumber = dto.PhoneNumber,
            Gender = dto.Gender,
            InsuranceId = dto.InsuranceId
        };

        isVisible = true;
        StateHasChanged();
    }

    private void Close()
    {
        isVisible = false;
    }

    private async Task HandleSubmit()
    {
        // await PatientService.UpdateAsync(patientId, updateDto);

        await OnSuccess.InvokeAsync();
        Close();
    }
}
``