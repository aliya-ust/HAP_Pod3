@using HealthCare.Admin.Shared
@using HealthCare.Shared.DTOs.Doctor
@inject DoctorService DoctorService
@inject ToastService ToastService

@if (isVisible)
{
    <div class="modal-backdrop show" style="background: rgba(30, 41, 59, 0.5); backdrop-filter: blur(2px);"></div>

    <div class="modal fade show d-block" tabindex="-1">
        <div class="modal-dialog modal-lg modal-dialog-centered">
            <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden">

                <div class="modal-header bg-slate-800 text-white p-4 border-0">
                    <h5 class="modal-title fw-bold">Add New Doctor</h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="Close"></button>
                </div>

                <div class="modal-body p-4 bg-white">
                    <EditForm Model="createDto" OnValidSubmit="HandleSubmit">
                        <DataAnnotationsValidator />

                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label fw-semibold">Full Name</label>
                                <InputText class="form-control" @bind-Value="createDto.FullName" />
                                <ValidationMessage For="@(() => createDto.FullName)" />
                            </div>

                            <div class="col-md-6">
                                <label class="form-label fw-semibold">Email</label>
                                <InputText class="form-control" @bind-Value="createDto.Email" />
                                <ValidationMessage For="@(() => createDto.Email)" />
                            </div>

                            <div class="col-md-6">
                                <label class="form-label fw-semibold">Password</label>
                                <InputText type="password" class="form-control" @bind-Value="createDto.Password" />
                                <ValidationMessage For="@(() => createDto.Password)" />
                            </div>

                            <div class="col-md-6">
                                <label class="form-label fw-semibold">Specialization</label>
                                <InputSelect class="form-select" @bind-Value="createDto.Specialisation">
                                    <option value="">-- Select --</option>
                                    @foreach (var spec in Specializations)
                                    {
                                        <option value="@spec">@spec</option>
                                    }
                                </InputSelect>
                                <ValidationMessage For="@(() => createDto.Specialisation)" />
                            </div>

                            <div class="col-md-6">
                                <label class="form-label fw-semibold">Years of Experience</label>
                                <InputNumber class="form-control" @bind-Value="createDto.YearsOfExperience" />
                                <ValidationMessage For="@(() => createDto.YearsOfExperience)" />
                            </div>

                            <div class="col-md-6">
                                <label class="form-label fw-semibold">Consultation Fee</label>
                                <InputNumber class="form-control" @bind-Value="createDto.ConsultationFee" />
                                <ValidationMessage For="@(() => createDto.ConsultationFee)" />
                            </div>

                            <div class="col-12">
                                <label class="form-label fw-semibold">Available Time Slots</label>
                                <div class="row">
                                    @foreach (var slot in AvailableSlots)
                                    {
                                        <div class="col-md-3 form-check">
                                            <input class="form-check-input"
                                                   type="checkbox"
                                                   checked="@createDto.TimeSlots.Contains(slot)"
                                                   @onchange="@(e => UpdateTimeSlots(slot, (bool)e.Value!))" />
                                            <label class="form-check-label">@slot</label>
                                        </div>
                                    }
                                </div>
                                <ValidationMessage For="@(() => createDto.TimeSlots)" />
                            </div>
                        </div>

                        <div class="d-flex justify-content-end gap-2 mt-4 pt-3 border-top">
                            <button type="button" class="btn btn-light px-4" @onclick="Close">Cancel</button>
                            <button type="submit" class="btn btn-dark px-4 shadow-sm" disabled="@isSaving">
                                @(isSaving ? "Saving..." : "Save Doctor")
                            </button>
                        </div>
                    </EditForm>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public EventCallback OnSuccess { get; set; }

    private List<string> Specializations => DoctorConstants.Specialisations;

    private CreateDoctorDto createDto = new();
    private bool isVisible = false;
    private bool isSaving = false;

    private List<string> AvailableSlots = new()
    {
        "09:00", "10:00", "11:00", "12:00", "13:00", "14:00", "15:00", "16:00"
    };

    private void UpdateTimeSlots(string slot, bool isChecked)
    {
        createDto.TimeSlots ??= new List<string>();

        if (isChecked)
        {
            if (!createDto.TimeSlots.Contains(slot)) createDto.TimeSlots.Add(slot);
        }
        else
        {
            createDto.TimeSlots.Remove(slot);
        }
    }

    public void Show()
    {
        createDto = new() { TimeSlots = new List<string>() };
        isVisible = true;
        StateHasChanged();
    }

    private void Close() => isVisible = false;

    private async Task HandleSubmit()
    {
        isSaving = true;
        try
        {
            await DoctorService.CreateAsync(createDto);
            await OnSuccess.InvokeAsync();
            Close();
            ToastService.Show("Success", "Doctor registered successfully.", NotificationType.Success);
        }
        catch (Exception ex)
        {
            ToastService.Show("Error", ex.Message, NotificationType.Error);
        }
        finally
        {
            isSaving = false;
        }
    }
}
